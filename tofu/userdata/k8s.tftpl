${file("${path_module}/userdata/generic")}
echo "starting k8s postinstall"

# Configure the network interfaces
cat <<'EOF' >/etc/systemd/network/10-octavia.link
[Match]
PermanentMACAddress=${mac_octavia}
[Link]
Name=octavia
EOF

cat <<'EOF' >/etc/systemd/network/10-octavia.network
[Match]
PermanentMACAddress=${mac_octavia}
[Network]
Address=172.21.0.5/16
EOF

systemctl restart systemd-udev-trigger.service
systemctl restart systemd-networkd.service

# Tune a little bit the number of open files
# This is useful for stern
cat <<'EOF' >/etc/sysctl.d/local.conf
fs.inotify.max_user_watches=999999
fs.inotify.max_user_instances=999999
fs.inotify.max_queued_events=999999
EOF

# Apply this new sysctl config
sysctl -p /etc/sysctl.d/local.conf

# Add useful aliases - not useful everywhere but at least we have them
cat << 'EOF' > /etc/profile.d/aliases.sh
alias k=kubectl
alias l=stern
alias os=openstack
alias frep-config='frep /root/bootstrap-openstack-k8s/k8s/config.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-rabbit='frep /root/bootstrap-openstack-k8s/k8s/rabbit.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-keystone='frep /root/bootstrap-openstack-k8s/k8s/keystone.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-glance='frep /root/bootstrap-openstack-k8s/k8s/glance.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-placement='frep /root/bootstrap-openstack-k8s/k8s/placement.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-neutron='frep /root/bootstrap-openstack-k8s/k8s/neutron.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-nova='frep /root/bootstrap-openstack-k8s/k8s/nova.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-skyline='frep /root/bootstrap-openstack-k8s/k8s/skyline.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-mistral='frep /root/bootstrap-openstack-k8s/k8s/mistral.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-octavia='frep /root/bootstrap-openstack-k8s/k8s/octavia.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-memcached='frep /root/bootstrap-openstack-k8s/k8s/memcached.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-barbican='frep /root/bootstrap-openstack-k8s/k8s/barbican.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-loki='frep /root/bootstrap-openstack-k8s/k8s/loki.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
alias frep-keycloak='frep /root/bootstrap-openstack-k8s/k8s/keycloak.yaml.in:- --load /root/bootstrap-openstack-k8s/config/config.yaml | kubectl apply -f -'
EOF

# We may need docker to build images
# Add Docker's official GPG key:
apt-get update
apt-get install ca-certificates curl
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

# Add the repository to Apt sources:
echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

git clone https://github.com/arnaudmorin/bootstrap-openstack-k8s.git /root/bootstrap-openstack-k8s -b feature/keycloak-oauth2-integration
git clone https://github.com/arnaudmorin/openstack-docker.git /root/openstack-docker -b ${os_version}

# Setup SSH config for easy access to computes and networks node
chmod 600 /root/bootstrap-openstack-k8s/ansible/files/zob

mkdir -p /root/.ssh/config.d/
echo "Include config.d/*" > /root/.ssh/config
tee /root/.ssh/config.d/os.conf << EOF
Match host="compute-*,network-*"
      User root
      StrictHostKeyChecking no
      UserKnownHostsFile /dev/null
      IdentityFile /root/bootstrap-openstack-k8s/ansible/files/zob
EOF

# Install k3s
curl -sfL https://get.k3s.io | sh -

kubectl get all

# Enable kubectl completion
kubectl completion bash > /etc/bash_completion.d/kubectl
echo 'complete -F __start_kubectl k' > /etc/profile.d/k.sh

# Install k9s
curl -sS https://webi.sh/k9s | HOME=/root sh

# Install frep
curl -fSL https://github.com/subchen/frep/releases/download/v1.3.12/frep-1.3.12-linux-amd64 -o /usr/local/bin/frep
chmod +x /usr/local/bin/frep

# Install osconsole
apt-get install -y jq
curl -fSL https://github.com/arnaudmorin/osconsole/releases/download/0.0.3/osconsole -o /usr/local/bin/osconsole
chmod +x /usr/local/bin/osconsole

cd /root/bootstrap-openstack-k8s
cp config/config.yaml.sample config/config.yaml
ip=$(hostname -I | awk '{print $1}')
sed -i -r "s/somewhere.net/$${ip}.xip.opensteak.fr/" config/config.yaml
sed -i -r "s/changeme/${password}/" config/config.yaml
sed -i -r "s/os_version/${os_version}/" config/config.yaml

# Stakater reloader
# This is not mandatory, but useful to auto-restart deployments / statefulset when a configmap change
kubectl apply -f https://raw.githubusercontent.com/stakater/Reloader/v1.4.8/deployments/kubernetes/reloader.yaml

# Config
frep k8s/config.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Mysql
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=keystone | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=nova | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=placement | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=neutron | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=glance | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=skyline | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=mistral | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=octavia | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=barbican | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=designate | kubectl apply -f -
frep k8s/mysql.yaml.in:- --load config/config.yaml --env db_name=keycloak | kubectl apply -f -
kubectl wait --for=condition=available --timeout=60s deployment/mysql-keystone
kubectl wait --for=condition=available --timeout=60s deployment/mysql-nova
kubectl wait --for=condition=available --timeout=60s deployment/mysql-placement
kubectl wait --for=condition=available --timeout=60s deployment/mysql-neutron
kubectl wait --for=condition=available --timeout=60s deployment/mysql-glance
kubectl wait --for=condition=available --timeout=60s deployment/mysql-skyline
kubectl wait --for=condition=available --timeout=60s deployment/mysql-mistral
kubectl wait --for=condition=available --timeout=60s deployment/mysql-octavia
kubectl wait --for=condition=available --timeout=60s deployment/mysql-barbican
kubectl wait --for=condition=available --timeout=60s deployment/mysql-keycloak

# Keycloak (OAuth2 authentication server) - Deploy early for parallel initialization
# Note: Keycloak uses MySQL (deployed above with db_name=keycloak)
frep k8s/keycloak.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Install Java (required for Keycloak CLI) - Do this early while Keycloak initializes
apt-get update
apt-get install -y default-jdk

# Download Keycloak CLI binaries
KEYCLOAK_VERSION=26.0.0
if [ ! -d /root/keycloak-26.0.0 ]; then
  echo "Downloading Keycloak 26.0.0..."
  curl -sL https://github.com/keycloak/keycloak/releases/download/26.0.0/keycloak-26.0.0.tar.gz | tar xz -C /root
fi

# Add Keycloak bin directory to PATH
echo 'export PATH="/root/keycloak-26.0.0/bin:$PATH"' >> /etc/profile.d/keycloak.sh

# Create Keycloak configuration file (similar to openrc files)
frep files/keycloakrc.in:/root/keycloakrc --load config/config.yaml

# Memcached
frep k8s/memcached.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Rabbit
frep k8s/rabbit.yaml.in:- --load config/config.yaml | kubectl apply -f -

# MySQL populate
frep k8s/mysql-populate.yaml.in:- --load config/config.yaml | kubectl apply -f -
kubectl wait --for=condition=complete --timeout=60s jobs/nova-init


# Keystone
# wait for memcached because we need it for a working keystone
kubectl wait --for=condition=available --timeout=60s deployment/memcached
frep k8s/keystone.yaml.in:- --load config/config.yaml | kubectl apply -f -
kubectl wait --for=condition=available --timeout=60s deployment/keystone

# Keystone bootstrap
apt-get install -y python3-venv
python3 -m venv /opt/oscli || echo "Venv creation failed"
/opt/oscli/bin/pip install --upgrade pip
/opt/oscli/bin/pip install python-openstackclient python-mistralclient python-octaviaclient osc-placement

ln -s /opt/oscli/bin/openstack /usr/local/bin/openstack
mkdir -p /etc/bash_completion.d/
openstack complete > /etc/bash_completion.d/openstack

frep files/openrc.in:/root/openrc_admin --load config/config.yaml \
     -e openrc_user=admin -e openrc_project=admin
frep files/openrc.in:/root/openrc_demo --load config/config.yaml \
     -e openrc_user=demo -e openrc_project=demo
cp files/helper /root/helper

# Create keystone resources
cd keystone-bootstrap
frep keystone-settings.yaml.in:keystone-settings.yaml --load ../config/config.yaml
source /opt/oscli/bin/activate
source /root/openrc_admin
./keystone-bootstrap --settings keystone-settings.yaml
cd ../

# Configure Keycloak (realm, clients, roles, users)
# Wait for Keycloak API pod to be ready before configuration
echo "Waiting for Keycloak API to be ready..."
kubectl wait --for=condition=available --timeout=300s deployment/keycloak || echo "Keycloak deployment may still be initializing"

# Source Keycloak configuration
source /etc/profile.d/keycloak.sh
source /root/keycloakrc

# Configure credentials for kcadm.sh
kcadm.sh config credentials \
  --server $${KEYCLOAK_URL} \
  --realm master \
  --user $${KEYCLOAK_USER} \
  --password $${KEYCLOAK_PASSWORD} > /dev/null 2>&1 || echo "Keycloak credentials configuration may have failed, retrying..."

# Wait for Keycloak to be fully ready (API responding)
echo "Waiting for Keycloak API to be fully ready..."
for i in {1..30}; do
  if kcadm.sh get realms 2>&1 | grep -q "openstack\|master"; then
    echo "Keycloak is ready"
    break
  fi
  echo "Waiting for Keycloak... ($i/30)"
  sleep 5
done

# Create realm if it doesn't exist
if ! kcadm.sh get realms/openstack 2>&1 | grep -q '"realm"'; then
  echo "Creating Keycloak realm: openstack"
  echo '{"realm": "openstack", "enabled": true}' | kcadm.sh create realms -f -
else
  echo "Keycloak realm 'openstack' already exists"
fi

# Create clients
echo "Configuring Keycloak clients..."

# Client: nova-middleware (for token introspection)
# Use realms/openstack/clients endpoint instead of clients --realm openstack
EXISTING_CLIENTS=$(kcadm.sh get realms/openstack/clients --fields clientId 2>&1 | python3 -c 'import sys, json; [print(c.get("clientId")) for c in json.load(sys.stdin)]' 2>/dev/null || echo "")

if ! echo "$EXISTING_CLIENTS" | grep -q "nova-middleware"; then
  echo "Creating client: nova-middleware"
  cat <<'EOF' | kcadm.sh create realms/openstack/clients -f -
{
  "clientId": "nova-middleware",
  "enabled": true,
  "clientAuthenticatorType": "client-secret",
  "serviceAccountsEnabled": true,
  "standardFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "publicClient": false,
  "protocol": "openid-connect"
}
EOF
else
  echo "Client 'nova-middleware' already exists"
fi

# Client: openstack-client (for user authentication)
if ! echo "$EXISTING_CLIENTS" | grep -q "openstack-client"; then
  echo "Creating client: openstack-client"
  cat <<'EOF' | kcadm.sh create realms/openstack/clients -f -
{
  "clientId": "openstack-client",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": true,
  "serviceAccountsEnabled": false,
  "redirectUris": ["*"],
  "webOrigins": ["*"],
  "protocol": "openid-connect"
}
EOF
else
  echo "Client 'openstack-client' already exists"
fi

# Get client UUIDs using Python for reliable JSON parsing
NOVA_MIDDLEWARE_UUID=$(kcadm.sh get realms/openstack/clients --fields id,clientId 2>&1 | python3 -c 'import sys, json; [print(c["id"]) for c in json.load(sys.stdin) if c.get("clientId") == "nova-middleware"]' 2>/dev/null || echo "")
OPENSTACK_CLIENT_UUID=$(kcadm.sh get realms/openstack/clients --fields id,clientId 2>&1 | python3 -c 'import sys, json; [print(c["id"]) for c in json.load(sys.stdin) if c.get("clientId") == "openstack-client"]' 2>/dev/null || echo "")

if [ -n "$OPENSTACK_CLIENT_UUID" ]; then
  echo "Adding protocol mappers to openstack-client..."
  
  # Check if mappers already exist using Python (we need 8: 5 original + project_domain_id, user_domain_id, openstack_roles string)
  EXISTING_MAPPERS=$(kcadm.sh get realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models 2>&1 | python3 -c 'import sys, json; print(len(json.load(sys.stdin)))' 2>/dev/null || echo "0")
  
  if [ "$EXISTING_MAPPERS" -lt "8" ]; then
    # Mapper for project_id
    echo '{"name": "project_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "project_id", "claim.name": "project_id", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    # Mapper for project_name
    echo '{"name": "project_name", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "project_name", "claim.name": "project_name", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    # Mapper for project_domain
    echo '{"name": "project_domain", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "project_domain", "claim.name": "project_domain", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    # Mapper for user_domain
    echo '{"name": "user_domain", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "user_domain", "claim.name": "user_domain", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    # Mapper for realm roles (realm_access.roles array) - kept for optional use
    echo '{"name": "openstack_roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper", "config": {"claim.name": "realm_access.roles", "multivalued": "true", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    # Mapper for project_domain_id (Nova middleware requires this claim)
    echo '{"name": "project_domain_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "project_domain_id", "claim.name": "project_domain_id", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    # Mapper for user_domain_id (Nova middleware requires this claim)
    echo '{"name": "user_domain_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "user_domain_id", "claim.name": "user_domain_id", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    # Mapper for openstack_roles as string (Nova middleware expects claim "openstack_roles" as comma-separated string)
    echo '{"name": "openstack_roles_string", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "openstack_roles", "claim.name": "openstack_roles", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | kcadm.sh create realms/openstack/clients/$${OPENSTACK_CLIENT_UUID}/protocol-mappers/models -f - 2>/dev/null || true
    
    echo "Protocol mappers added"
  else
    echo "Protocol mappers already exist"
  fi
fi

# Fix Keycloak User Profile configuration to register custom attributes
# This is required in Keycloak 26.x for attributes to persist
echo ""
echo "🔧 Updating User Profile to register custom attributes..."

# Get current profile using kcadm.sh (it uses REST API under the hood)
PROFILE_JSON=$(kcadm.sh get realms/openstack/users/profile 2>/dev/null || echo "{}")

# Check if we need to add custom attributes
NEEDS_UPDATE=false
for attr_name in project_id project_name project_domain user_domain project_domain_id user_domain_id openstack_roles; do
  if ! echo "$PROFILE_JSON" | python3 -c "import sys, json; profile=json.load(sys.stdin); attrs=[a.get('name') for a in profile.get('attributes', [])]; sys.exit(0 if '$attr_name' in attrs else 1)" 2>/dev/null; then
    echo "Adding attribute: $attr_name"
    NEEDS_UPDATE=true
  fi
done

if [ "$NEEDS_UPDATE" = "true" ]; then
  # Update profile using kcadm.sh authentication with Python requests
  python3 << 'PYTHON_EOF'
import subprocess
import json
import sys
import os
import requests

# Get Keycloak URL from environment
keycloak_url = os.environ.get('KEYCLOAK_URL', '')
admin_user = os.environ.get('KEYCLOAK_USER', 'admin')
admin_password = os.environ.get('KEYCLOAK_PASSWORD', '')

if not keycloak_url or not admin_password:
    print("⚠️  Keycloak environment variables not set", file=sys.stderr)
    sys.exit(1)

# Get admin token using kcadm.sh (it handles authentication)
# First, get token by calling kcadm.sh's internal mechanism
# We'll use kcadm.sh config to ensure credentials are set, then get token
try:
    # Get token using kcadm.sh's authentication
    # kcadm.sh stores token in ~/.keycloak/kcadm.config, but we can also get it via API
    # For simplicity, we'll use requests to get token (same as kcadm.sh does internally)
    token_url = f'{keycloak_url}/realms/master/protocol/openid-connect/token'
    token_data = {
        'client_id': 'admin-cli',
        'username': admin_user,
        'password': admin_password,
        'grant_type': 'password'
    }
    token_resp = requests.post(token_url, data=token_data, timeout=10)
    token_resp.raise_for_status()
    admin_token = token_resp.json().get('access_token', '')
    
    if not admin_token:
        print("⚠️  Failed to get admin token", file=sys.stderr)
        sys.exit(1)
except Exception as e:
    print(f"⚠️  Failed to authenticate: {e}", file=sys.stderr)
    sys.exit(1)

# Get current profile using kcadm.sh
try:
    result = subprocess.run(['kcadm.sh', 'get', 'realms/openstack/users/profile'], 
                          capture_output=True, text=True, check=True)
    profile = json.loads(result.stdout)
except:
    profile = {"attributes": [], "groups": []}

# Custom attributes to add
custom_attrs = [
    {
        'name': 'project_id',
        'displayName': 'OpenStack Project ID',
        'permissions': {'view': ['admin'], 'edit': ['admin']},
        'multivalued': False
    },
    {
        'name': 'project_name',
        'displayName': 'OpenStack Project Name',
        'permissions': {'view': ['admin'], 'edit': ['admin']},
        'multivalued': False
    },
    {
        'name': 'project_domain',
        'displayName': 'OpenStack Project Domain',
        'permissions': {'view': ['admin'], 'edit': ['admin']},
        'multivalued': False
    },
    {
        'name': 'user_domain',
        'displayName': 'OpenStack User Domain',
        'permissions': {'view': ['admin'], 'edit': ['admin']},
        'multivalued': False
    },
    {
        'name': 'project_domain_id',
        'displayName': 'OpenStack Project Domain Id',
        'permissions': {'view': ['admin'], 'edit': ['admin']},
        'multivalued': False
    },
    {
        'name': 'user_domain_id',
        'displayName': 'OpenStack User Domain Id',
        'permissions': {'view': ['admin'], 'edit': ['admin']},
        'multivalued': False
    },
    {
        'name': 'openstack_roles',
        'displayName': 'OpenStack Roles',
        'permissions': {'view': ['admin'], 'edit': ['admin']},
        'multivalued': False
    }
]

existing_names = {a.get('name') for a in profile.get('attributes', [])}
added = False
for attr in custom_attrs:
    if attr['name'] not in existing_names:
        profile.setdefault('attributes', []).append(attr)
        print(f"Adding attribute: {attr['name']}", file=sys.stderr)
        added = True

if added:
    # Update profile using REST API with token (kcadm.sh uses same mechanism internally)
    profile_url = f'{keycloak_url}/admin/realms/openstack/users/profile'
    headers = {
        'Authorization': f'Bearer {admin_token}',
        'Content-Type': 'application/json'
    }
    try:
        update_resp = requests.put(profile_url, json=profile, headers=headers, timeout=10)
        update_resp.raise_for_status()
        print("✅ User Profile updated successfully")
    except requests.exceptions.RequestException as e:
        print(f"⚠️  User Profile update failed: {e}", file=sys.stderr)
        if hasattr(e, 'response') and e.response is not None:
            print(f"   Response: {e.response.text}", file=sys.stderr)
        sys.exit(1)
else:
    print("✅ User Profile already has custom attributes")
PYTHON_EOF
else
  echo "✅ User Profile already has custom attributes"
fi

# Create role: nova:reboot
if ! kcadm.sh get realms/openstack/roles 2>&1 | grep -q '"name" : "nova:reboot"'; then
  echo "Creating role: nova:reboot"
  echo '{"name": "nova:reboot", "description": "Permission to reboot Nova instances"}' | kcadm.sh create realms/openstack/roles -f -
else
  echo "Role 'nova:reboot' already exists"
fi

# Get project ID and default domain ID from OpenStack for the demo project
source /root/openrc_admin 2>/dev/null || true
PROJECT_ID=$(openstack project show demo -c id -f value 2>/dev/null || echo "")
PROJECT_NAME="demo"
DEFAULT_DOMAIN_ID=$(openstack domain show default -c id -f value 2>/dev/null || echo "default")

if [ -z "$PROJECT_ID" ]; then
  echo "⚠️  Warning: Could not get demo project ID from OpenStack"
  echo "   You may need to configure the Keycloak user manually"
else
  # Delete existing user if it exists
  EXISTING_USER=$(kcadm.sh get realms/openstack/users --query username=nova-restart-user 2>&1 | python3 -c 'import sys, json; users = json.load(sys.stdin); [print(u["id"]) for u in users if u.get("username") == "nova-restart-user"]' 2>/dev/null || echo "")
  
  if [ -n "$EXISTING_USER" ]; then
    echo "Deleting existing user: nova-restart-user"
    kcadm.sh delete realms/openstack/users/$${EXISTING_USER} 2>/dev/null || true
  fi
  
  # Create user: nova-restart-user (with credentials in initial creation for persistence)
  echo "Creating user: nova-restart-user"
  cat <<EOF | kcadm.sh create realms/openstack/users -f -
{
  "username": "nova-restart-user",
  "enabled": true,
  "emailVerified": true,
  "requiredActions": [],
  "email": "nova-restart@example.com",
  "firstName": "Nova",
  "lastName": "Restart",
  "attributes": {
    "project_id": ["$${PROJECT_ID}"],
    "project_name": ["$${PROJECT_NAME}"],
    "project_domain": ["Default"],
    "user_domain": ["Default"],
    "project_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "user_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "openstack_roles": ["nova:reboot"]
  },
  "credentials": [{
    "type": "password",
    "value": "changeme",
    "temporary": false
  }]
}
EOF
  
  # Assign role
  kcadm.sh add-roles --realm openstack --uusername nova-restart-user --rolename nova:reboot 2>/dev/null || true
  
  echo "✅ User nova-restart-user created with project $${PROJECT_NAME} ($${PROJECT_ID})"
  
  # Create demo user for testing
  DEMO_USER_EXISTS=$(kcadm.sh get realms/openstack/users --query username=demo 2>&1 | python3 -c 'import sys, json; users = json.load(sys.stdin); [print(u["id"]) for u in users if u.get("username") == "demo"]' 2>/dev/null || echo "")
  
  if [ -n "$DEMO_USER_EXISTS" ]; then
    echo "Deleting existing user: demo"
    kcadm.sh delete realms/openstack/users/$${DEMO_USER_EXISTS} 2>/dev/null || true
  fi
  
  # Get demo user password from openrc_demo if available
  DEMO_PASSWORD=$(grep "^export OS_PASSWORD=" /root/openrc_demo 2>/dev/null | cut -d'=' -f2 | tr -d '"' || echo "HbSsd5CCkd5R42tDrjke3YE4vAnDJPBf")
  
  echo "Creating user: demo"
  cat <<EOF | kcadm.sh create realms/openstack/users -f -
{
  "username": "demo",
  "enabled": true,
  "emailVerified": true,
  "requiredActions": [],
  "email": "demo@example.com",
  "firstName": "Demo",
  "lastName": "User",
  "attributes": {
    "project_id": ["$${PROJECT_ID}"],
    "project_name": ["$${PROJECT_NAME}"],
    "project_domain": ["Default"],
    "user_domain": ["Default"],
    "project_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "user_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "openstack_roles": ["default,member"]
  },
  "credentials": [{
    "type": "password",
    "value": "$${DEMO_PASSWORD}",
    "temporary": false
  }]
}
EOF
  
  echo "✅ User demo created with project $${PROJECT_NAME} ($${PROJECT_ID})"
  
  # Create demo-reboot-only user (Keycloak OAuth2 reboot test)
  DEMO_REBOOT_EXISTS=$(kcadm.sh get realms/openstack/users --query username=demo-reboot-only 2>&1 | python3 -c 'import sys, json; users = json.load(sys.stdin); [print(u["id"]) for u in users if u.get("username") == "demo-reboot-only"]' 2>/dev/null || echo "")
  if [ -n "$DEMO_REBOOT_EXISTS" ]; then
    kcadm.sh delete realms/openstack/users/$${DEMO_REBOOT_EXISTS} 2>/dev/null || true
  fi
  echo "Creating user: demo-reboot-only"
  cat <<EOF | kcadm.sh create realms/openstack/users -f -
{
  "username": "demo-reboot-only",
  "enabled": true,
  "emailVerified": true,
  "requiredActions": [],
  "email": "demo-reboot@example.com",
  "firstName": "Demo",
  "lastName": "RebootOnly",
  "attributes": {
    "project_id": ["$${PROJECT_ID}"],
    "project_name": ["$${PROJECT_NAME}"],
    "project_domain": ["Default"],
    "user_domain": ["Default"],
    "project_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "user_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "openstack_roles": ["nova:reboot"]
  },
  "credentials": [{
    "type": "password",
    "value": "$${DEMO_PASSWORD}",
    "temporary": false
  }]
}
EOF
  kcadm.sh add-roles --realm openstack --uusername demo-reboot-only --rolename nova:reboot 2>/dev/null || true
  echo "✅ User demo-reboot-only created (nova:reboot)"
  
  # Create demo-keycloak user (Keycloak OAuth2 create-instance test)
  DEMO_KC_EXISTS=$(kcadm.sh get realms/openstack/users --query username=demo-keycloak 2>&1 | python3 -c 'import sys, json; users = json.load(sys.stdin); [print(u["id"]) for u in users if u.get("username") == "demo-keycloak"]' 2>/dev/null || echo "")
  if [ -n "$DEMO_KC_EXISTS" ]; then
    kcadm.sh delete realms/openstack/users/$${DEMO_KC_EXISTS} 2>/dev/null || true
  fi
  echo "Creating user: demo-keycloak"
  cat <<EOF | kcadm.sh create realms/openstack/users -f -
{
  "username": "demo-keycloak",
  "enabled": true,
  "emailVerified": true,
  "requiredActions": [],
  "email": "demo-kc@example.com",
  "firstName": "Demo",
  "lastName": "Keycloak",
  "attributes": {
    "project_id": ["$${PROJECT_ID}"],
    "project_name": ["$${PROJECT_NAME}"],
    "project_domain": ["Default"],
    "user_domain": ["Default"],
    "project_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "user_domain_id": ["$${DEFAULT_DOMAIN_ID}"],
    "openstack_roles": ["default,member"]
  },
  "credentials": [{
    "type": "password",
    "value": "$${DEMO_PASSWORD}",
    "temporary": false
  }]
}
EOF
  kcadm.sh add-roles --realm openstack --uusername demo-keycloak --rolename default 2>/dev/null || true
  kcadm.sh add-roles --realm openstack --uusername demo-keycloak --rolename member 2>/dev/null || true
  echo "✅ User demo-keycloak created (default,member)"
fi

# Get client secret for nova-middleware
echo ""
echo "🔑 Retrieving client secret for nova-middleware..."
if [ -n "$NOVA_MIDDLEWARE_UUID" ]; then
  CLIENT_SECRET=$(kcadm.sh get realms/openstack/clients/$${NOVA_MIDDLEWARE_UUID}/client-secret 2>&1 | python3 -c 'import sys, json; print(json.load(sys.stdin).get("value", ""))' 2>/dev/null || echo "")
  
  if [ -n "$CLIENT_SECRET" ] && [ "$CLIENT_SECRET" != "null" ] && [ -n "$CLIENT_SECRET" ]; then
    echo "Client secret: $${CLIENT_SECRET}"
    # Update config.yaml with the secret
    if grep -q "keycloak_client_secret:" config/config.yaml; then
      sed -i "s/keycloak_client_secret:.*/keycloak_client_secret: $${CLIENT_SECRET}/" config/config.yaml
      echo "✅ Updated keycloak_client_secret in config/config.yaml"
    else
      echo "keycloak_client_secret: $${CLIENT_SECRET}" >> config/config.yaml
      echo "✅ Added keycloak_client_secret to config/config.yaml"
    fi
  else
    echo "⚠️  Could not retrieve client secret. You may need to configure it manually."
  fi
else
  echo "⚠️  Could not find nova-middleware client UUID"
fi

echo "✅ Keycloak configuration completed!"

# Glance
frep k8s/glance.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Placement
frep k8s/placement.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Neutron
frep k8s/neutron.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Nova
frep k8s/nova.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Mistral
frep k8s/mistral.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Skyline
frep k8s/skyline.yaml.in:- --load config/config.yaml | kubectl apply -f -

# Barbican
frep k8s/barbican.yaml.in:- --load config/config.yaml | kubectl apply -f -


kubectl wait --for=condition=available --timeout=60s deployment/nova-api
kubectl wait --for=condition=available --timeout=60s deployment/glance
kubectl wait --for=condition=available --timeout=60s deployment/neutron-api

# Pre-populate openstack
source /root/openrc_admin
source /root/helper

create_flavors
create_image_cirros
create_image_debian

source /root/openrc_demo
create_rules
create_key

# Octavia bootstrap
# ansible-playbook ansible/bootstrap-octavia.yaml

frep files/openrc.in:/root/openrc_octavia --load config/config.yaml \
     -e openrc_user=octavia -e openrc_project=service

source /root/openrc_octavia
set -xv
openstack network create \
          --provider-physical-network provider-octavia \
          --provider-network-type flat \
          lb-mgmt-net

openstack subnet create \
          --network lb-mgmt-net \
          --subnet-range 172.21.0.0/16 \
          --no-dhcp \
          --dns-nameserver 1.1.1.1 \
          --allocation-pool start=172.21.0.16,end=172.21.255.254 \
          lb-mgmt-subnet

openstack security group create octavia-amphora --description "Security group for octavia amphpora"
openstack security group rule create octavia-amphora --ingress --protocol tcp --dst-port 9443 --remote-ip 0.0.0.0/0
openstack security group rule create octavia-amphora --ingress --protocol tcp --dst-port 22 --remote-ip 0.0.0.0/0
openstack security group rule create octavia-amphora --ingress --protocol icmp --remote-ip 0.0.0.0/0

openstack keypair create --private-key /root/.ssh/octavia.priv amphora_keypair

set +xv

curl -fL -o /root/amphora.qcow2 https://tarballs.opendev.org/openstack/octavia/test-images/test-only-amphora-x64-haproxy-ubuntu-noble.qcow2

set -xv
openstack image create \
          --file /root/amphora.qcow2 \
          --container-format bare \
          --disk-format qcow2 \
          --tag amphora \
          --public \
          amphora

set +xv

octavia_flavor=$(openstack flavor show medium -f json | jq -r ".id")
octavia_net=$(openstack network show lb-mgmt-net -f json | jq -r ".id")
octavia_secgroup=$(openstack security group show octavia-amphora -f json | jq -r ".id")

sed -ir "s/amp_flavor_id/$${octavia_flavor}/" config/config.yaml
sed -ir "s/amp_boot_network_list/$${octavia_net}/" config/config.yaml
sed -ir "s/amp_secgroup_list/$${octavia_secgroup}/" config/config.yaml

# Octavia
frep k8s/config.yaml.in:- --load config/config.yaml | kubectl apply -f -
frep k8s/octavia.yaml.in:- --load config/config.yaml | kubectl apply -f -
kubectl wait --for=condition=available --timeout=60s deployment/octavia-api

echo "done"
