#!/bin/bash


function create_flavors(){(
    set -xv
    openstack flavor create --vcpus 1 --ram 1024 --disk 10 small
    openstack flavor create --vcpus 2 --ram 2048 --disk 20 medium
    openstack flavor create --vcpus 4 --ram 4086 --disk 50 large
)}

function create_image_cirros(){(
    [ -f cirros-0.6.2-x86_64-disk.img ] || curl -fLO https://download.cirros-cloud.net/0.6.2/cirros-0.6.2-x86_64-disk.img
    set -xv
    openstack image create \
     --file cirros-0.6.2-x86_64-disk.img \
     --container-format bare \
     --disk-format qcow2 \
     --property hw_disk_bus=scsi \
     --property hw_scsi_model=virtio-scsi \
     --property os_type=linux \
     --property os_distro=cirros \
     --property os_admin_user=cirros \
     --property os_version='0.6.2' \
     --public \
     "cirros"
)}

function create_image_debian(){(
    [ -f debian-13-genericcloud-amd64.qcow2 ] || curl -fLO https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
    set -xv
    openstack image create \
     --file debian-13-genericcloud-amd64.qcow2 \
     --container-format bare \
     --disk-format qcow2 \
     --property hw_disk_bus=scsi \
     --property hw_scsi_model=virtio-scsi \
     --property os_type=linux \
     --property os_distro=debian \
     --property os_admin_user=debian \
     --property os_version='13.0.0' \
     --public \
     "Debian 13"
)}

function create_key(){(
    set -xv
    openstack keypair create --public-key ~/.ssh/authorized_keys zob
)}

function create_rules(){(
    set -xv
    openstack security group rule create --ingress --protocol any default
    # Already supposed to exist
    #openstack security group rule create --egress  --protocol any default
)}

function create_server_private(){(
    set -xv
    openstack server create \
     --flavor small \
     --image cirros \
     --net private \
     --key-name zob \
     n1
)}

function create_server_public(){(
    set -xv
    openstack server create \
     --flavor small \
     --image cirros \
      --net public \
      --key-name zob \
     p1
)}

function create_floating(){(
    set -xv
    openstack floating ip create public
)}

function attach_floating(){(
    NAME=$1
    IP=$2
    set -xv
    openstack server add floating ip $NAME $IP
)}

function create_network_public(){(
    START=$1
    END=$2
    if [[ $START == 51.91.90.* ]] ; then
        # This is the only /25 that I currently have
        # So I can hardcode the values here
        RANGE="51.91.90.0/25"
        GATEWAY="51.91.90.126"
    else
        # Try to compute from START
        RANGE=$(ipcalc -n -b ${START}/28 | grep 'Network:' | awk '{print $2}')
        GATEWAY=$(ipcalc -n -b ${START}/28 | grep 'HostMax:' | awk '{print $2}')
    fi

    set -xv
    openstack network create \
     --share \
     --external \
     --provider-physical-network provider \
     --provider-network-type flat \
     public

    openstack subnet create \
     --network public \
     --subnet-range "$RANGE" \
     --allocation-pool "start=${START},end=${END}" \
     --gateway $GATEWAY \
     --dns-nameserver 1.1.1.1 \
     "$RANGE"

    # Add a private subnet in this public network
    # The service-type network:floatingip_agent_gateway
    # will let IPAM give IP from this subnet for FIP namespaces
    # This is used to reduce number of public IP on neutron DVR
    # Note that we still need to set a valid next-hop gateway
    # ($GATEWAY here)
    openstack subnet create \
     --network public \
     --subnet-range 172.31.0.0/17 \
     --gateway $GATEWAY \
     --no-dhcp \
     --service-type 'network:floatingip_agent_gateway' \
     _internal_fip_subnet
)}

function create_network_private(){(
    set -xv
    openstack network create private
    openstack subnet create \
     --network private \
     --subnet-range "192.168.42.0/24" \
     --gateway 192.168.42.1 \
     --dns-nameserver 8.8.8.8 \
     "192.168.42.0/24"
)}

function create_router(){(
    set -xv
    openstack router create router
    openstack router set --external-gateway public router
    openstack router add subnet router 192.168.42.0/24
)}

function create_workflow(){(
    set -xv
    openstack workflow execution create create_instance '{"name":"test-from-wf", "image":"cirros", "flavor":"small", "keypair":"zob", "network":"private"}'
)}

function osconsole_search() {
    if [ "$#" -ne 1 ]; then
        echo "usage: osconsole_search <instance>"
        return
    fi

    local url=$(openstack console url show --serial $1 -f json | jq -r ".url")
    osconsole $url
}

function create_network_provisioning(){(
    set -xv
    openstack network create \
     --share \
     --provider-physical-network flat \
     --provider-network-type flat \
     provisioning

    openstack subnet create \
     --network provisioning \
     --subnet-range 172.22.0.0/16 \
     --allocation-pool start=172.22.1.0,end=172.22.255.254 \
     --gateway none \
     provisioning
)}

function create_images_ipa(){(
    set -xve
    release=$(awk -F'"' '/^openstack_version:/ {print $2}' /root/bootstrap-openstack-k8s/config/config.yaml)
    cd /root
    for f in kernel initramfs; do
        curl -fLO https://tarballs.opendev.org/openstack/ironic-python-agent/dib/files/ipa-debian-stable-$release.$f
        curl -fLO https://tarballs.opendev.org/openstack/ironic-python-agent/dib/files/ipa-debian-stable-$release.$f.sha256
        sha256sum -c ipa-debian-stable-$release.$f.sha256
    done
    openstack image create --file ipa-debian-stable-$release.kernel --container-format aki --disk-format aki --community ipa-kernel
    openstack image create --file ipa-debian-stable-$release.initramfs --container-format ari --disk-format ari --community ipa-ramdisk
)}

function create_flavor_baremetal(){(
    set -xv
    openstack flavor create --vcpus 1 --ram 1024 --disk 10 \
     --property resources:CUSTOM_BAREMETAL=1 \
     --property resources:VCPU=0 \
     --property resources:MEMORY_MB=0 \
     --property resources:DISK_GB=0 \
     baremetal
)}

# NOTE(aruan) enrolls the instances <prefix>-baremetal-N in Ironic and removes the nodes
# whose instance is gone: run it again after changing baremetal_count in tofu
function sync_baremetal_nodes(){(
    set -e
    config=/root/bootstrap-openstack-k8s/config/config.yaml
    prefix=$(awk '/^baremetal_prefix:/ {print $2}' $config | tr -d '"')
    firmware=$(awk '/^baremetal_firmware:/ {print $2}' $config | tr -d '"')
    # The cloud hosting the cluster, with the credential of sushy-emulator
    host_cloud() {( unset $(compgen -v OS_); OS_CLIENT_CONFIG_FILE=/root/baremetal/clouds.yaml openstack --os-cloud ovh "$@" )}

    instances=$(host_cloud server list --name "^$prefix-baremetal-" -f value -c ID -c Name)
    echo "bare metal instances:"
    echo "$instances"

    kubectl create configmap sushy-allowed --from-literal=instances="$(echo "$instances" | awk '{print $1}' | xargs)" \
        --dry-run=client -o yaml | kubectl apply -f -
    kubectl rollout restart deployment/sushy-emulator
    kubectl rollout status deployment/sushy-emulator --timeout=180s

    kernel=$(openstack image show ipa-kernel -f value -c id)
    ramdisk=$(openstack image show ipa-ramdisk -f value -c id)
    echo "$instances" | while read -r id name; do
        [ -n "$id" ] || continue
        openstack baremetal node show "$name" >/dev/null 2>&1 && continue
        mac=$(host_cloud port list --server "$id" -f value -c "MAC Address" | head -1)
        uuid=$(openstack baremetal node create --name "$name" --driver redfish \
            --driver-info redfish_address=http://sushy-emulator:8000 \
            --driver-info redfish_system_id=/redfish/v1/Systems/$id \
            --driver-info deploy_kernel=$kernel \
            --driver-info deploy_ramdisk=$ramdisk \
            --resource-class baremetal \
            --property capabilities=boot_mode:$firmware \
            -f value -c uuid)
        openstack baremetal port create "$mac" --node "$uuid" --physical-network flat
        openstack baremetal node manage "$name" --wait 300
        openstack baremetal node provide "$name"
    done

    openstack baremetal node list -f value -c Name -c "Provisioning State" | while read -r name state; do
        case "$name" in "$prefix"-baremetal-*) ;; *) continue ;; esac
        echo "$instances" | awk '{print $2}' | grep -qx "$name" && continue
        case "$state" in
            available|manageable|enroll) openstack baremetal node delete "$name" ;;
            *) echo "WARNING: the instance of $name is gone but the node is $state: undeploy it first" ;;
        esac
    done
)}
