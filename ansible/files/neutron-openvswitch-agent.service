[Unit]
Description=OpenStack neutron-openvswitch-agent
After=openvswitch-switch.service network-online.target local-fs.target remote-fs.target 
Wants=openvswitch-switch.service network-online.target 

[Service]
User=neutron
Group=neutron
Type=notify
WorkingDirectory=~
RuntimeDirectory=neutron lock/neutron
CacheDirectory=neutron
ExecStart=/opt/openstack/neutron/bin/neutron-openvswitch-agent --config-file /etc/neutron/neutron.conf --config-file /etc/neutron/plugins/ml2/openvswitch_agent.ini --log-file /var/log/neutron-openvswitch-agent.log
Restart=on-failure
LimitNOFILE=65535
TimeoutStopSec=15
NotifyAccess=all

[Install]
WantedBy=multi-user.target
