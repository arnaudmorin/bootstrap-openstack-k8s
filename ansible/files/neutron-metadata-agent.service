[Unit]
Description=OpenStack neutron-metadata-agent
After=openvswitch-switch.service network-online.target local-fs.target remote-fs.target 
Wants=openvswitch-switch.service network-online.target 

[Service]
User=neutron
Group=neutron
WorkingDirectory=~
RuntimeDirectory=neutron lock/neutron
CacheDirectory=neutron
ExecStart=/opt/openstack/neutron/bin/neutron-metadata-agent --config-file /etc/neutron/neutron.conf --config-file /etc/neutron/metadata_agent.ini --log-file /var/log/neutron-metadata-agent.log
Restart=on-failure
LimitNOFILE=65535
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
