---
apiVersion: v1
kind: Service
metadata:
  name: keystone
spec:
  selector:
    app: keystone
  ports:
  - port: 5000

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: keystone
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: keystone.{{ .domain }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: keystone
            port:
              number: 5000

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keystone
  labels:
    app: keystone
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 3
  selector:
    matchLabels:
      app: keystone
  template:
    metadata:
      labels:
        app: keystone
    spec:
      initContainers:
      - name: keystone-db-sync
        image: arnaudmorin/openstack-keystone:{{.openstack_version}}
        command: ["/opt/openstack/keystone/bin/keystone-manage", "db_sync"]
        volumeMounts:
        - name: keystone-conf
          mountPath: /etc/keystone/keystone.conf
          subPath: keystone.conf
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/0
          subPath: "0"
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/1
          subPath: "1"
      - name: keystone-bootstrap
        image: arnaudmorin/openstack-keystone:{{.openstack_version}}
        command: ["/opt/openstack/keystone/bin/keystone-manage", "bootstrap",
          "--bootstrap-password", "{{.password}}",
          "--bootstrap-admin-url", "http://keystone.{{.domain}}/v3/",
          "--bootstrap-internal-url", "http://keystone.{{.domain}}/v3/",
          "--bootstrap-public-url", "http://keystone.{{.domain}}/v3/",
          "--bootstrap-region-id", "RegionOne"]
        volumeMounts:
        - name: keystone-conf
          mountPath: /etc/keystone/keystone.conf
          subPath: keystone.conf
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/0
          subPath: "0"
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/1
          subPath: "1"
      containers:
      - name: keystone
        image: arnaudmorin/openstack-keystone:{{.openstack_version}}
        command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        args: [ "chmod 600 /etc/keystone/fernet-keys && /opt/openstack/keystone/bin/uwsgi --http :5000 -w keystone.wsgi.api:application" ]
        # imagePullPolicy: Always
        ports:
        - containerPort: 5000
        volumeMounts:
        - name: keystone-conf
          mountPath: /etc/keystone/keystone.conf
          subPath: keystone.conf
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/0
          subPath: "0"
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/1
          subPath: "1"
      volumes:
      - name: keystone-conf
        configMap:
          name: keystone-conf
