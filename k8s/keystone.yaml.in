---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keystone-conf
data:
  uwsgi.ini: |
    [uwsgi]
    http-socket = 0.0.0.0:5000
    stats = 0.0.0.0:9191
    virtualenv = /opt/openstack/keystone/
    module = keystone.wsgi.api:application
    buffer-size = 65535
    lazy-apps = true
    processes = 8
    harakiri = 60
    enable-threads = true
    master = true
    thunder-lock = true
  keystone.conf: |
    [DEFAULT]
    [database]
    connection = mysql+pymysql://root:{{ .password }}@mysql-keystone/keystone
    [catalog]
    template_file = /etc/keystone/default_catalog.templates
    [oslo_policy]
    policy_dirs = /etc/keystone/policy.d
    [token]
    provider = fernet
    [credential]
    # demo: reuse the same key material as the fernet token keys
    key_repository = /etc/keystone/credential-keys
    [identity]
    # avoid a bcrypt warning
    max_password_length = 72
    [cache]
    enabled = True
    backend = dogpile.cache.redis
    redis_server = redis:6379
    password = {{ .password }}
    # os --os-profile {{ .password }} token issue
    # then /opt/oscli/bin/osprofiler trace show --html --connection-string redis://:{{.password}}@{{.domain}}:30679 TRACEID
    [profiler]
    enabled = True
    trace_sqlalchemy = True
    hmac_keys = {{ .password }}
    connection_string = redis://:{{ .password }}@redis:6379
  0: |
    {{ index .keystone.fernet 0 }}
  1: |
    {{ index .keystone.fernet 1 }}

---
apiVersion: v1
kind: Service
metadata:
  name: keystone
spec:
  selector:
    app: keystone
  ports:
  - port: 5000

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: keystone
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: keystone.{{ .domain }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: keystone
            port:
              number: 5000

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keystone
  labels:
    app: keystone
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 3
  selector:
    matchLabels:
      app: keystone
  template:
    metadata:
      labels:
        app: keystone
    spec:
      initContainers:
      - name: keystone-db-sync
        image: arnaudmorin/openstack-keystone:{{.openstack_version}}
        command: ["/opt/openstack/keystone/bin/keystone-manage", "db_sync"]
        volumeMounts:
        - name: keystone-conf
          mountPath: /etc/keystone/keystone.conf
          subPath: keystone.conf
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/0
          subPath: "0"
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/1
          subPath: "1"
      - name: keystone-bootstrap
        image: arnaudmorin/openstack-keystone:{{.openstack_version}}
        command: ["/opt/openstack/keystone/bin/keystone-manage", "bootstrap",
          "--bootstrap-password", "{{.password}}",
          "--bootstrap-admin-url", "http://keystone.{{.domain}}/v3/",
          "--bootstrap-internal-url", "http://keystone.{{.domain}}/v3/",
          "--bootstrap-public-url", "http://keystone.{{.domain}}/v3/",
          "--bootstrap-region-id", "RegionOne"]
        volumeMounts:
        - name: keystone-conf
          mountPath: /etc/keystone/keystone.conf
          subPath: keystone.conf
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/0
          subPath: "0"
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/1
          subPath: "1"
      containers:
      - name: keystone
        image: arnaudmorin/openstack-keystone:{{.openstack_version}}
        command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        args: [ "chmod 600 /etc/keystone/fernet-keys /etc/keystone/credential-keys && /opt/openstack/keystone/bin/uwsgi --ini /etc/uwsgi/keystone.ini" ]
        # imagePullPolicy: Always
        ports:
        - containerPort: 5000
        # Keep not-ready replicas out of the Service so traefik never routes to a
        # pod whose uwsgi isn't serving yet (avoids 502s during rollout/reload).
        # GET /v3 is the unauthenticated version endpoint.
        readinessProbe:
          httpGet:
            path: /v3
            port: 5000
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
        volumeMounts:
        - name: keystone-conf
          mountPath: /etc/keystone/keystone.conf
          subPath: keystone.conf
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/0
          subPath: "0"
        - name: keystone-conf
          mountPath: /etc/keystone/fernet-keys/1
          subPath: "1"
        - name: keystone-conf
          mountPath: /etc/keystone/credential-keys/0
          subPath: "0"
        - name: keystone-conf
          mountPath: /etc/keystone/credential-keys/1
          subPath: "1"
        - name: keystone-conf
          mountPath: /etc/uwsgi/keystone.ini
          subPath: uwsgi.ini
      volumes:
      - name: keystone-conf
        configMap:
          name: keystone-conf
