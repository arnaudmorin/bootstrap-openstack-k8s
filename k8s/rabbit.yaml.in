---
apiVersion: v1
kind: ConfigMap
metadata:
  name: rabbit-conf
data:
  rabbitmq.conf: |
    default_pass = {{.password}}
    default_user = openstack
---
apiVersion: v1
kind: Service
metadata:
  name: rabbit
spec:
  selector:
    app: rabbit
  ports:
  - port: 5672
    nodePort: 30672
    name: rabbit
  # Rabbit service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by neutron/nova agents)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: rabbit-management
spec:
  selector:
    app: rabbit
  ports:
  - port: 15672

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: rabbit
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: rabbit.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: rabbit-management
            port:
              number: 15672

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rabbit
spec:
  selector:
    matchLabels:
      app: rabbit
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: rabbit
    spec:
      containers:
      - image: rabbitmq:4-management
        name: rabbit
        ports:
        - containerPort: 5672
          name: rabbit
        - containerPort: 15672
          name: management
        volumeMounts:
        - name: rabbit-conf
          mountPath: "/etc/rabbitmq/rabbitmq.conf"
          subPath: "rabbitmq.conf"
      volumes:
      - name: rabbit-conf
        configMap:
          name: rabbit-conf
