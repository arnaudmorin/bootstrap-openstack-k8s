---
apiVersion: v1
kind: ConfigMap
metadata:
  name: rabbit-conf
data:
  rabbitmq.conf: |
    default_pass = {{.password}}
    default_user = openstack
    # NOTE(arnaud) rabbit has no persistent volume, so policies are (re)loaded
    # from definitions.json at every boot instead of using rabbitmqctl set_policy
    load_definitions = /etc/rabbitmq/definitions.json
  # The openstack user/vhost/permissions are also declared here so that they
  # exist no matter how the definitions import interacts with default_user.
  definitions.json: |
    {
      "users": [
        {"name": "openstack", "password": "{{.password}}", "tags": ["administrator"]}
      ],
      "vhosts": [
        {"name": "/"}
      ],
      "permissions": [
        {"user": "openstack", "vhost": "/", "configure": ".*", "write": ".*", "read": ".*"}
      ],
      "policies": [
        {
          "vhost": "/",
          "name": "quorum-policy",
          "pattern": "^(?!amq\\.).*",
          "apply-to": "quorum_queues",
          "priority": 0,
          "definition": {"expires": 86400000, "message-ttl": 600000}
        },
        {
          "vhost": "/",
          "name": "stream-policy",
          "pattern": ".*_fanout.*",
          "apply-to": "streams",
          "priority": 0,
          "definition": {"max-length-bytes": 15000000, "stream-max-segment-size-bytes": 5000000}
        }
      ]
    }
---
apiVersion: v1
kind: Service
metadata:
  name: rabbit
spec:
  selector:
    app: rabbit
  ports:
  - port: 5672
    nodePort: 30672
    name: rabbit
  # Rabbit service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by neutron/nova agents)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: rabbit-management
spec:
  selector:
    app: rabbit
  ports:
  - port: 15672

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: rabbit
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: rabbit.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: rabbit-management
            port:
              number: 15672

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rabbit
spec:
  selector:
    matchLabels:
      app: rabbit
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: rabbit
    spec:
      containers:
      - image: rabbitmq:4-management
        name: rabbit
        ports:
        - containerPort: 5672
          name: rabbit
        - containerPort: 15672
          name: management
        # NOTE(arnaud) the AMQP listener only opens late in the boot
        readinessProbe:
          tcpSocket:
            port: 5672
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
        volumeMounts:
        - name: rabbit-conf
          mountPath: "/etc/rabbitmq/rabbitmq.conf"
          subPath: "rabbitmq.conf"
        - name: rabbit-conf
          mountPath: "/etc/rabbitmq/definitions.json"
          subPath: "definitions.json"
      volumes:
      - name: rabbit-conf
        configMap:
          name: rabbit-conf
