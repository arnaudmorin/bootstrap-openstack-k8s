---
apiVersion: v1
kind: Service
metadata:
  name: skyline
spec:
  selector:
    app: skyline
  ports:
  - port: 8080

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: skyline
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: skyline.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: skyline
            port:
              number: 8080

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: skyline
  labels:
    app: skyline
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: skyline
  template:
    metadata:
      labels:
        app: skyline
    spec:
      initContainers:
      - name: skyline-init
        image: arnaudmorin/openstack-skyline:{{.openstack_version}}
        #imagePullPolicy: Always
        command: ["/usr/local/bin/skyline-db-sync"]
        volumeMounts:
        - name: skyline-conf
          mountPath: /etc/skyline/skyline.yaml
          subPath: skyline.yaml
      containers:
      - name: skyline
        image: arnaudmorin/openstack-skyline:{{.openstack_version}}
        command: [ "/usr/local/bin/skyline-start"]
        #imagePullPolicy: Always
        ports:
        - containerPort: 8080
        volumeMounts:
        - name: skyline-conf
          mountPath: /etc/skyline/skyline.yaml
          subPath: skyline.yaml
      volumes:
      - name: skyline-conf
        configMap:
          name: skyline-conf
