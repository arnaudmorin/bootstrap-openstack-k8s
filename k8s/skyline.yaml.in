---
apiVersion: v1
kind: ConfigMap
metadata:
  name: skyline-conf
data:
  skyline.yaml: |
    default:
      access_token_expire: 3600
      access_token_renew: 1800
      cafile: ''
      cors_allow_origins: []
      database_url: mysql+pymysql://root:{{.password}}@mysql-skyline/skyline
      debug: False
      # NOTE(arnaud) log to the container output instead of files in /var/log/skyline
      # log_dir is also used by skyline-nginx-generator for nginx logs
      log_dir: /dev
      log_file: stderr
      access_log_file: stdout
      error_log_file: stderr
      policy_file_path: /etc/skyline/policy
      policy_file_suffix: policy.yaml
      prometheus_basic_auth_password: ''
      prometheus_basic_auth_user: ''
      prometheus_enable_basic_auth: false
      prometheus_endpoint: http://localhost:9091
      secret_key: aCtmgbcUqYUy_HNVg5BDXCaeJgJQzHJXwqbXr0Nmb2o
      session_name: session
      ssl_enabled: true
    openstack:
      base_domains:
      - default
      default_region: RegionOne
      enforce_new_defaults: true
      interface_type: public
      keystone_url: http://keystone.{{.domain}}/v3
      nginx_prefix: /api/openstack
      reclaim_instance_interval: 604800
      service_mapping:
        compute: nova
        identity: keystone
        image: glance
        network: neutron
        placement: placement
      sso_enabled: false
      sso_protocols:
      - openid
      sso_region: RegionOne
      system_admin_roles:
      - admin
      - system_admin
      system_project: service
      system_project_domain: default
      system_reader_roles:
      - system_reader
      system_user_domain: default
      system_user_name: skyline
      system_user_password: {{.password}}
    setting:
      base_settings:
      - flavor_families
      - gpu_models
      - usb_models
      flavor_families:
      - architecture: x86_architecture
        categories:
        - name: general_purpose
          properties: []
        - name: compute_optimized
          properties: []
        - name: memory_optimized
          properties: []
        - name: high_clock_speed
          properties: []
      - architecture: heterogeneous_computing
        categories:
        - name: compute_optimized_type_with_gpu
          properties: []
        - name: visualization_compute_optimized_type_with_gpu
          properties: []
      gpu_models:
      - nvidia_t4
      usb_models:
      - usb_c
  # NOTE(arnaud) same as upstream etc/gunicorn.py, but logging to the container
  # output instead of files in /var/log/skyline
  gunicorn.py: |
    import multiprocessing

    bind = "unix:/var/lib/skyline/skyline.sock"
    reuse_port = False
    workers = (1 + multiprocessing.cpu_count()) // 2
    worker_class = "uvicorn.workers.UvicornWorker"
    timeout = 300
    keepalive = 5
    proc_name = "skyline"
    errorlog = "-"
    accesslog = "-"
    loglevel = "info"

---
apiVersion: v1
kind: Service
metadata:
  name: skyline
spec:
  selector:
    app: skyline
  ports:
  - port: 8080

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: skyline
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: skyline.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: skyline
            port:
              number: 8080

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: skyline
  labels:
    app: skyline
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: skyline
  template:
    metadata:
      labels:
        app: skyline
    spec:
      initContainers:
      - name: skyline-init
        image: ghcr.io/arnaudmorin/openstack-skyline:{{.openstack_version}}
        #imagePullPolicy: Always
        command: ["/usr/local/bin/skyline-db-sync"]
        volumeMounts:
        - name: skyline-conf
          mountPath: /etc/skyline/skyline.yaml
          subPath: skyline.yaml
      containers:
      - name: skyline
        image: ghcr.io/arnaudmorin/openstack-skyline:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/usr/local/bin/skyline-start"]
        #imagePullPolicy: Always
        ports:
        - containerPort: 8080
        # NOTE(arnaud) / is served by nginx alone, so check an API path that
        # goes through nginx to gunicorn, it does not need authentication
        readinessProbe:
          httpGet:
            path: /api/openstack/skyline/api/v1/contrib/regions
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
        volumeMounts:
        - name: skyline-conf
          mountPath: /etc/skyline/skyline.yaml
          subPath: skyline.yaml
        - name: skyline-conf
          mountPath: /etc/skyline/gunicorn.py
          subPath: gunicorn.py
      volumes:
      - name: skyline-conf
        configMap:
          name: skyline-conf
