---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cinder-conf
data:
  uwsgi.ini: |
    [uwsgi]
    http-socket = 0.0.0.0:8776
    stats = 0.0.0.0:9191
    virtualenv = /opt/openstack/cinder/
    module = cinder.wsgi.api
    buffer-size = 65535
    lazy-apps = true
    processes = 8
    harakiri = 60
    enable-threads = true
    master = true
    thunder-lock = true
    # NOTE(arnaud) advertise Connection: close so traefik does not pool and
    # reuse backend keepalive connections. A reused-but-dropped connection
    # makes POSTs fail non-retryably as an intermittent traefik 500/502
    # under concurrent load (e.g. tempest create_subnet).
    add-header = Connection: close
  cinder.conf: |
    [DEFAULT]
    # debug = True
    auth_strategy = keystone
    transport_url = rabbit://openstack:{{.password}}@rabbit
    enabled_backends = nfs
    glance_api_servers = http://glance.{{.domain}}
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-cinder/cinder
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = cinder
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [oslo_concurrency]
    lock_path = /var/lock/cinder
    [nfs]
    volume_driver=cinder.volume.drivers.nfs.NfsDriver
    nas_host=10.201.95.118
    nas_share_path=/zpool-bhs-000917/cinder-k8s
    nfs_snapshot_support=True
    nfs_mount_options='vers=3,nolock'
    [cache]
    backend = dogpile.cache.redis
    redis_server = redis:6379
    password = {{ .password }}
    [oslo_messaging_rabbit]
    rabbit_quorum_queue = True
    rabbit_transient_quorum_queue = True
    rabbit_qos_prefetch_count = 1
    use_queue_manager = True
    rabbit_stream_fanout = True

---
apiVersion: v1
kind: Service
metadata:
  name: cinder
spec:
  selector:
    app: cinder
  ports:
  - port: 8776

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: cinder
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  rules:
  - host: cinder.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: cinder
            port:
              number: 8776

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cinder
  labels:
    app: cinder
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cinder
  template:
    metadata:
      labels:
        app: cinder
    spec:
      initContainers:
      - name: cinder
        image: arnaudmorin/openstack-cinder:{{.openstack_version}}
        command: ["/opt/openstack/cinder/bin/cinder-manage", "db", "sync"]
        volumeMounts:
        - name: cinder-conf
          mountPath: /etc/cinder/cinder.conf
          subPath: cinder.conf
      containers:
      - name: cinder
        image: arnaudmorin/openstack-cinder:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/cinder/bin/uwsgi", "--ini", "/etc/uwsgi/cinder.ini" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        ports:
        - containerPort: 8776
        readinessProbe:
          httpGet:
            path: /
            port: 8776
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
        volumeMounts:
        - name: cinder-conf
          mountPath: /etc/cinder/cinder.conf
          subPath: cinder.conf
        - name: cinder-conf
          mountPath: /etc/uwsgi/cinder.ini
          subPath: uwsgi.ini
      volumes:
      - name: cinder-conf
        configMap:
          name: cinder-conf

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: cinder-scheduler
  labels:
    app: cinder-scheduler
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cinder-scheduler
  template:
    metadata:
      labels:
        app: cinder-scheduler
    spec:
      containers:
      - name: cinder-scheduler
        image: arnaudmorin/openstack-cinder:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/cinder/bin/cinder-scheduler" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        volumeMounts:
        - name: cinder-conf
          mountPath: /etc/cinder/cinder.conf
          subPath: cinder.conf
      volumes:
      - name: cinder-conf
        configMap:
          name: cinder-conf

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: cinder-volume
  labels:
    app: cinder-volume
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cinder-volume
  template:
    metadata:
      labels:
        app: cinder-volume
    spec:
      containers:
      - name: cinder-volume
        image: arnaudmorin/openstack-cinder:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/cinder/bin/cinder-volume" ]
        securityContext:
          privileged: true
          runAsUser: 0
        # imagePullPolicy: Always
        volumeMounts:
        - name: cinder-conf
          mountPath: /etc/cinder/cinder.conf
          subPath: cinder.conf
      volumes:
      - name: cinder-conf
        configMap:
          name: cinder-conf
