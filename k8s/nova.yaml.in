---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nova-conf
data:
  uwsgi-api.ini: |
    [uwsgi]
    http-socket = 0.0.0.0:8774
    stats = 0.0.0.0:9191
    virtualenv = /opt/openstack/nova/
    module = nova.wsgi.osapi_compute
    buffer-size = 65535
    lazy-apps = true
    processes = 8
    harakiri = 60
    enable-threads = true
    master = true
    thunder-lock = true
  uwsgi-metadata.ini: |
    [uwsgi]
    http-socket = 0.0.0.0:8775
    stats = 0.0.0.0:9191
    virtualenv = /opt/openstack/nova/
    module = nova.wsgi.metadata
    buffer-size = 65535
    lazy-apps = true
    processes = 8
    harakiri = 60
    enable-threads = true
    master = true
    thunder-lock = true
  nova.conf: |
    [DEFAULT]
    transport_url = rabbit://openstack:{{.password}}@rabbit
    [api_database]
    connection = mysql+pymysql://root:{{.password}}@mysql-nova/nova_api
    os_region_name = RegionOne
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-nova/nova
    [glance]
    api_servers = http://glance.{{.domain}}
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = nova
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [neutron]
    default_floating_pool = ext-net
    service_metadata_proxy = true
    metadata_proxy_shared_secret = {{.password}}
    auth_type = password
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = neutron
    user_domain_name = Default
    password = {{.password}}
    service_name = neutron
    url = http://neutron.{{.domain}}
    region_name = RegionOne
    [oslo_concurrency]
    lock_path = /var/lib/nova/tmp
    [placement]
    auth_type = password
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = placement
    user_domain_name = Default
    password = {{.password}}
    region_name = RegionOne
    [scheduler]
    discover_hosts_in_cells_interval = 60
    [serial_console]
    enabled = true
    [spice]
    enabled = true
    server_listen = 0.0.0.0
    server_proxyclient_address = $my_ip
    # This does not work, I dont know why...
    html5proxy_base_url = http://nova.{{.domain}}:6082/spice_auto.html
    [vnc]
    enabled = true
    server_listen = 0.0.0.0
    server_proxyclient_address = $my_ip
    [cache]
    backend = dogpile.cache.redis
    redis_server = redis:6379
    password = {{ .password }}
    [oslo_messaging_rabbit]
    rabbit_quorum_queue = True
    rabbit_transient_quorum_queue = True
    rabbit_qos_prefetch_count = 1
    use_queue_manager = True
    rabbit_stream_fanout = True

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nova-init-script
data:
  init.sh: |
    #!/bin/bash
    # Every command below is idempotent, so this script is safe to run on every
    # (re)start
    set -e

    shopt -s expand_aliases
    alias nova-manage="/opt/openstack/nova/bin/nova-manage"

    # Schema syncs are no-ops when the DB is already up to date
    nova-manage api_db sync

    # map_cell0 updates the existing mapping if present (idempotent)
    nova-manage cell_v2 map_cell0

    # create_cell is NOT idempotent (nova allows duplicate cells with the same
    # name), so only create cell1 when it is missing.
    # NOTE: no 'set -o pipefail' on purpose -- with 'grep -q' it would misfire, as
    # grep closes the pipe on the first match and nova-manage then dies on SIGPIPE.
    if ! nova-manage cell_v2 list_cells | grep -q cell1; then
        nova-manage cell_v2 create_cell --name=cell1 --verbose
    fi

    # Db sync is also idempotent
    nova-manage db sync

---
apiVersion: v1
kind: Service
metadata:
  name: nova-api
spec:
  selector:
    app: nova-api
  ports:
  - port: 8774

---
apiVersion: v1
kind: Service
metadata:
  name: nova-metadata-api
spec:
  selector:
    app: nova-metadata-api
  ports:
  - port: 8775
    nodePort: 30775
    name: nova-metadata-api
  # Nova metadata service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by neutron metadata agents)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: nova-vnc
spec:
  selector:
    app: nova-vnc
  ports:
  - port: 6080
    nodePort: 30080
    name: nova-vnc
  # Nova vnc service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by clients)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: nova-spice
spec:
  selector:
    app: nova-spice
  ports:
  - port: 6082
    nodePort: 30082
    name: nova-spice
  # Nova spice service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by clients)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: nova-serial
spec:
  selector:
    app: nova-serial
  ports:
  - port: 6083
    nodePort: 30083
    name: nova-serial
  # Nova serial service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by clients)
  type: LoadBalancer

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: nova-api
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: nova.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: nova-api
            port:
              number: 8774

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nova-api
  labels:
    app: nova-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nova-api
  template:
    metadata:
      labels:
        app: nova-api
    spec:
      initContainers:
      # Runs api_db sync + cell_v2 setup + db sync (idempotent; see the
      # nova-init-script ConfigMap above).
      - name: nova-init
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: ["bash", "/scripts/init.sh"]
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
        - name: nova-init-script
          mountPath: /scripts
      containers:
      - name: nova-api
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        env:
        - name: OS_NOVA_DISABLE_EVENTLET_PATCHING
          value: "1"
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/nova/bin/uwsgi", "--ini", "/etc/uwsgi/nova-api.ini" ]
        #imagePullPolicy: Always
        ports:
        - containerPort: 8774
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
        - name: nova-conf
          mountPath: /etc/uwsgi/nova-api.ini
          subPath: uwsgi-api.ini
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf
      - name: nova-init-script
        configMap:
          name: nova-init-script

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nova-metadata-api
  labels:
    app: nova-metadata-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nova-metadata-api
  template:
    metadata:
      labels:
        app: nova-metadata-api
    spec:
      initContainers:
      # Wait for nova-api, which runs the idempotent db/cell init; nova-api only
      # serves once that init container has finished, so this gates the migration
      - name: wait-nova-api
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: ["bash", "-c", "until curl -s --max-time 5 -o /dev/null http://nova-api:8774/; do echo 'waiting for nova-api db/cell init...'; sleep 3; done"]
      containers:
      - name: nova-metadata-api
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        env:
        - name: OS_NOVA_DISABLE_EVENTLET_PATCHING
          value: "1"
        command: [ "/opt/openstack/nova/bin/uwsgi", "--ini", "/etc/uwsgi/nova-metadata.ini" ]
        #imagePullPolicy: Always
        ports:
        - containerPort: 8775
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
        - name: nova-conf
          mountPath: /etc/uwsgi/nova-metadata.ini
          subPath: uwsgi-metadata.ini
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: nova-conductor
  labels:
    app: nova-conductor
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: nova-conductor
  template:
    metadata:
      labels:
        app: nova-conductor
    spec:
      initContainers:
      # Wait for nova-api, which runs the idempotent db/cell init; nova-api only
      # serves once that init container has finished, so this gates the migration
      - name: wait-nova-api
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: ["bash", "-c", "until curl -s --max-time 5 -o /dev/null http://nova-api:8774/; do echo 'waiting for nova-api db/cell init...'; sleep 3; done"]
      containers:
      - name: nova-conductor
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        env:
        - name: OS_NOVA_DISABLE_EVENTLET_PATCHING
          value: "1"
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/nova/bin/nova-conductor" ]
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        #imagePullPolicy: Always
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf

---
