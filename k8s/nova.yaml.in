---
apiVersion: v1
kind: Service
metadata:
  name: nova-api
spec:
  selector:
    app: nova-api
  ports:
  - port: 8774

---
apiVersion: v1
kind: Service
metadata:
  name: nova-metadata-api
spec:
  selector:
    app: nova-metadata-api
  ports:
  - port: 8775
    nodePort: 30775
    name: nova-metadata-api
  # Nova metadata service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by neutron metadata agents)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: nova-vnc
spec:
  selector:
    app: nova-vnc
  ports:
  - port: 6080
    nodePort: 30080
    name: nova-vnc
  # Nova vnc service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by clients)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: nova-spice
spec:
  selector:
    app: nova-spice
  ports:
  - port: 6082
    nodePort: 30082
    name: nova-spice
  # Nova spice service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by clients)
  type: LoadBalancer

---
apiVersion: v1
kind: Service
metadata:
  name: nova-serial
spec:
  selector:
    app: nova-serial
  ports:
  - port: 6083
    nodePort: 30083
    name: nova-serial
  # Nova serial service is type LoadBalancer in order to be reachable from outside the k8s cluster (used by clients)
  type: LoadBalancer

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: nova-api
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: nova.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: nova-api
            port:
              number: 8774

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nova-api
  labels:
    app: nova-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app: nova-api
  template:
    metadata:
      labels:
        app: nova-api
    spec:
      initContainers:
      - name: nova-api-db-sync
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: ["/opt/openstack/nova/bin/nova-manage", "api_db", "sync"]
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      - name: nova-db-sync
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: ["/opt/openstack/nova/bin/nova-manage", "db", "sync"]
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      containers:
      - name: nova-api
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        # Use paste deploy to support both Keystone and OAuth2 authentication
        # PYTHONPATH includes /etc/nova for nova_oauth2_middleware.py (CompositeAuthMiddleware)
        command: [ "/bin/bash", "-c", "--" ]
        args: [ "cd /opt/openstack/nova && exec /opt/openstack/nova/bin/uwsgi --http :8774 --wsgi-file /opt/openstack/nova/bin/nova-api-wsgi" ]
        env:
        - name: PYTHONPATH
          value: "/etc/nova:/opt/openstack/nova/lib/python3.13/site-packages"
        #imagePullPolicy: Always
        ports:
        - containerPort: 8774
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
        - name: nova-conf
          mountPath: /etc/nova/api-paste.ini
          subPath: api-paste.ini
        - name: nova-conf
          mountPath: /etc/nova/nova_oauth2_middleware.py
          subPath: nova_oauth2_middleware.py
        - name: nova-policy
          mountPath: /etc/nova/policy.d
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf
      - name: nova-policy
        configMap:
          name: nova-policy

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nova-metadata-api
  labels:
    app: nova-metadata-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nova-metadata-api
  template:
    metadata:
      labels:
        app: nova-metadata-api
    spec:
      containers:
      - name: nova-metadata-api
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: [ "/opt/openstack/nova/bin/uwsgi", "--http", ":8775", "--wsgi-file", "/opt/openstack/nova/bin/nova-metadata-wsgi" ]
        #imagePullPolicy: Always
        ports:
        - containerPort: 8775
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: nova-conductor
  labels:
    app: nova-conductor
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: nova-conductor
  template:
    metadata:
      labels:
        app: nova-conductor
    spec:
      containers:
      - name: nova-conductor
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/nova/bin/nova-conductor" ]
        #imagePullPolicy: Always
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: nova-scheduler
  labels:
    app: nova-scheduler
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: nova-scheduler
  template:
    metadata:
      labels:
        app: nova-scheduler
    spec:
      containers:
      - name: nova-scheduler
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/nova/bin/nova-scheduler" ]
        #imagePullPolicy: Always
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf

---
apiVersion: apps/v1
