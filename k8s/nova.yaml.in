metadata:
  name: nova-vnc
  labels:
    app: nova-vnc
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nova-vnc
  template:
    metadata:
      labels:
        app: nova-vnc
