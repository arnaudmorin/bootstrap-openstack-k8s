---
apiVersion: batch/v1
kind: Job
metadata:
  name: nova-init
spec:
  template:
    spec:
      restartPolicy: Never
      initContainers:
      - name: nova-init
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: ["/opt/openstack/nova/bin/init.sh"]
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      containers:
      - name: nova-done
        image: arnaudmorin/openstack-nova:{{.openstack_version}}
        command: ["echo", "done"]
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf

---
#
# CINDER JOBS
#
apiVersion: batch/v1
kind: Job
metadata:
 name: cinder-init
spec:
 template:
   spec:
     restartPolicy: Never
     containers:
     - name: cinder
       image: arnaudmorin/openstack-cinder:{{.openstack_version}}
       command: ["/opt/openstack/cinder/bin/cinder-manage", "db", "sync"]
       volumeMounts:
       - name: cinder-conf
         mountPath: /etc/cinder/cinder.conf
         subPath: cinder.conf
     volumes:
     - name: cinder-conf
       configMap:
         name: cinder-conf
 backoffLimit: 4

