---
# NOTE(arnaud) this nova init job is doing the cell configuration
# db-sync is done in nova-api deployment using init container like any other
# service
apiVersion: batch/v1
kind: Job
metadata:
  name: nova-init
spec:
  template:
    spec:
      restartPolicy: Never
      initContainers:
      - name: nova-init
        image: antoninruan/openstack-nova:{{.openstack_version}}
        command: ["/opt/openstack/nova/bin/init.sh"]
        volumeMounts:
        - name: nova-conf
          mountPath: /etc/nova/nova.conf
          subPath: nova.conf
      containers:
      - name: nova-done
        image: antoninruan/openstack-nova:{{.openstack_version}}
        command: ["echo", "done"]
      volumes:
      - name: nova-conf
        configMap:
          name: nova-conf
---
apiVersion: batch/v1
kind: Job
metadata:
  name: octavia-init
spec:
  template:
    spec:
      restartPolicy: Never
      containers:
      - name: octavia
        image: antoninruan/openstack-octavia:{{.openstack_version}}
        command: [ "/opt/openstack/octavia/bin/octavia-db-manage", "--config-file", "/etc/octavia/octavia.conf", "upgrade", "head" ]
        volumeMounts:
        - name: octavia-conf
          mountPath: /etc/octavia/octavia.conf
          subPath: octavia.conf
      volumes:
      - name: octavia-conf
        configMap:
          name: octavia-conf
