---
apiVersion: v1
kind: ConfigMap
metadata:
  name: placement-conf
data:
  placement.conf: |
    [DEFAULT]
    [api]
    auth_strategy = keystone
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = placement
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [oslo_policy]
    policy_dirs = /etc/placement/policy.d
    [placement_database]
    connection = mysql+pymysql://root:{{.password}}@mysql-placement/placement
    [placement]
    # See https://bugs.launchpad.net/placement/+bug/2070257
    max_allocation_candidates = 1000
    allocation_candidates_generation_strategy = breadth-first
    [cache]
    backend = dogpile.cache.redis
    redis_server = redis:6379
    password = {{ .password }}

---
apiVersion: v1
kind: Service
metadata:
  name: placement
spec:
  selector:
    app: placement
  ports:
  - port: 8778

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: placement
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: placement.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: placement
            port:
              number: 8778

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: placement
  labels:
    app: placement
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: placement
  template:
    metadata:
      labels:
        app: placement
    spec:
      initContainers:
      - name: placement-init
        image: arnaudmorin/openstack-placement:{{.openstack_version}}
        command: ["/opt/openstack/placement/bin/placement-manage", "db", "sync"]
        volumeMounts:
        - name: placement-conf
          mountPath: /etc/placement/placement.conf
          subPath: placement.conf
      containers:
      - name: placement
        image: arnaudmorin/openstack-placement:{{.openstack_version}}
        command: [ "/opt/openstack/placement/bin/uwsgi", "--http", "0.0.0.0:8778", "--module", "placement.wsgi.api:application", "-b", "65535"]
        # imagePullPolicy: Always
        ports:
        - containerPort: 8778
        volumeMounts:
        - name: placement-conf
          mountPath: /etc/placement/placement.conf
          subPath: placement.conf
      volumes:
      - name: placement-conf
        configMap:
          name: placement-conf
