---
apiVersion: v1
kind: Service
metadata:
  name: placement
spec:
  selector:
    app: placement
  ports:
  - port: 8778

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: placement
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: placement.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: placement
            port:
              number: 8778

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: placement
  labels:
    app: placement
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: placement
  template:
    metadata:
      labels:
        app: placement
    spec:
      initContainers:
      - name: placement-init
        image: antoninruan/openstack-placement:{{.openstack_version}}
        command: ["/opt/openstack/placement/bin/placement-manage", "db", "sync"]
        volumeMounts:
        - name: placement-conf
          mountPath: /etc/placement/placement.conf
          subPath: placement.conf
      containers:
      - name: placement
        image: antoninruan/openstack-placement:{{.openstack_version}}
        command: [ "/opt/openstack/placement/bin/uwsgi", "--http", "0.0.0.0:8778", "--module", "placement.wsgi.api:application", "-b", "65535"]
        # imagePullPolicy: Always
        ports:
        - containerPort: 8778
        volumeMounts:
        - name: placement-conf
          mountPath: /etc/placement/placement.conf
          subPath: placement.conf
      volumes:
      - name: placement-conf
        configMap:
          name: placement-conf
