---
apiVersion: v1
kind: ConfigMap
metadata:
  name: glance-conf
data:
  glance-api.conf: |
    [DEFAULT]
    # debug = True
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-glance/glance
    [glance_store]
    stores = file,http
    default_store = file
    filesystem_store_datadir = /var/lib/glance/images/
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = glance
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [oslo_concurrency]
    lock_path = /var/lock/glance
    [paste_deploy]
    flavor = keystone
    [taskflow_executor]
    conversion_format = raw
    [task]
    task_executor = taskflow
    work_dir = /tmp
    [image_conversion]
    output_format = raw
    [image_import_opts]
    image_import_plugins = ['image_conversion']
    [cache]
    backend = dogpile.cache.redis
    redis_server = redis:6379
    password = {{ .password }}
  glance-image-import.conf: |
    [image_conversion]
    output_format = raw
    [image_import_opts]
    image_import_plugins = ['image_conversion']

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: glance-pv-claim
spec:
  storageClassName: local-path
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 20Gi

---
apiVersion: v1
kind: Service
metadata:
  name: glance
spec:
  selector:
    app: glance
  ports:
  - port: 9292

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: glance
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: glance.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: glance
            port:
              number: 9292



---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: glance
  labels:
    app: glance
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: glance
  template:
    metadata:
      labels:
        app: glance
    spec:
      initContainers:
      - name: glance-init
        image: arnaudmorin/openstack-glance:{{.openstack_version}}
        command: ["/opt/openstack/glance/bin/glance-manage", "db_sync"]
        volumeMounts:
        - name: glance-conf
          mountPath: /etc/glance/glance-api.conf
          subPath: glance-api.conf
      containers:
      - name: glance
        image: arnaudmorin/openstack-glance:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/glance/bin/uwsgi", "--http", ":9292", "--module", "glance.wsgi.api" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        #imagePullPolicy: Always
        ports:
        - containerPort: 9292
        volumeMounts:
        - name: glance-conf
          mountPath: /etc/glance/glance-api.conf
          subPath: glance-api.conf
        - name: glance-persistent-storage
          mountPath: /var/lib/glance
      volumes:
      - name: glance-conf
        configMap:
          name: glance-conf
      - name: glance-persistent-storage
        persistentVolumeClaim:
          claimName: glance-pv-claim
