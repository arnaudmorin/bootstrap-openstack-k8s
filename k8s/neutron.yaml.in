---
apiVersion: v1
kind: Service
metadata:
  name: neutron
spec:
  selector:
    app: neutron-api
  ports:
  - port: 9696

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: neutron
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: neutron.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: neutron
            port:
              number: 9696

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: neutron-api
  labels:
    app: neutron-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app: neutron-api
  template:
    metadata:
      labels:
        app: neutron-api
    spec:
      initContainers:
      - name: neutron
        image: antoninruan/openstack-neutron:{{.openstack_version}}
        command: ["/opt/openstack/neutron/bin/neutron-db-manage", "--config-file", "/etc/neutron/neutron.conf", "--config-file", "/etc/neutron/plugins/ml2/ml2_conf.ini", "upgrade", "head"]
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      containers:
      - name: neutron-api
        image: antoninruan/openstack-neutron:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/neutron/bin/uwsgi", "--http", ":9696", "--module", "neutron.wsgi.api" ]
        # imagePullPolicy: Always
        ports:
        - containerPort: 9696
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      volumes:
      - name: neutron-conf
        configMap:
          name: neutron-conf
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: neutron-rpc
  labels:
    app: neutron-rpc
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: neutron-rpc
  template:
    metadata:
      labels:
        app: neutron-rpc
    spec:
      containers:
      - name: neutron-rpc
        image: antoninruan/openstack-neutron:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/neutron/bin/neutron-rpc-server" ]
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      volumes:
      - name: neutron-conf
        configMap:
          name: neutron-conf

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: neutron-wireguard-rpc
  labels:
    app: neutron-wireguard-rpc
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: neutron-wireguard-rpc
  template:
    metadata:
      labels:
        app: neutron-wireguard-rpc
    spec:
      containers:
      - name: neutron-wireguard-rpc
        image: antoninruan/openstack-neutron:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/neutron/bin/neutron-wireguard-rpc" ]
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      volumes:
      - name: neutron-conf
        configMap:
          name: neutron-conf
