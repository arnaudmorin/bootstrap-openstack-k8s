---
apiVersion: v1
kind: ConfigMap
metadata:
  name: neutron-conf
data:
  neutron.conf: |
    [DEFAULT]
    # debug = True
    auth_strategy = keystone
    core_plugin = ml2
    service_plugins = router,segments,port_forwarding,qos,wireguard
    allow_overlapping_ips = true
    notify_nova_on_port_status_changes = true
    notify_nova_on_port_data_changes = true
    interface_driver = openvswitch
    router_distributed = true
    l3_ha = true
    max_l3_agents_per_router = 2
    transport_url = rabbit://openstack:{{.password}}@rabbit
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-neutron/neutron
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = neutron
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [nova]
    region_name = RegionOne
    auth_url = http://keystone.{{.domain}}/v3
    auth_type = password
    password = {{.password}}
    project_domain_name = Default
    project_name = service
    user_domain_name = Default
    username = nova
    [oslo_concurrency]
    lock_path = /var/lib/neutron/tmp
    [oslo_policy]
    policy_file = /etc/neutron/policy.json
    policy_dirs = /etc/neutron/policy.d
    [placement]
    region_name = RegionOne
    auth_url = http://keystone.{{.domain}}/v3
    auth_type = password
    password = {{.password}}
    project_domain_name = Default
    project_name = service
    user_domain_name = Default
    username = placement
    [oslo_messaging_rabbit]
    rabbit_quorum_queue = True
    rabbit_transient_quorum_queue = True
    rabbit_qos_prefetch_count = 1
    use_queue_manager = True
    rabbit_stream_fanout = True
  ml2_conf.ini: |
    [ml2]
    type_drivers = flat,vlan,vxlan
    tenant_network_types = vxlan
    mechanism_drivers = openvswitch,l2population
    extension_drivers = port_security,qos
    [ml2_type_flat]
    flat_networks = *
    [ml2_type_vxlan]
    vni_ranges = 1:1000
    [securitygroup]
    enable_ipset = true
    [cache]
    backend = dogpile.cache.redis
    redis_server = redis:6379
    password = {{ .password }}

---
apiVersion: v1
kind: Service
metadata:
  name: neutron
spec:
  selector:
    app: neutron-api
  ports:
  - port: 9696

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: neutron
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: neutron.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: neutron
            port:
              number: 9696

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: neutron-api
  labels:
    app: neutron-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app: neutron-api
  template:
    metadata:
      labels:
        app: neutron-api
    spec:
      initContainers:
      - name: neutron
        image: arnaudmorin/openstack-neutron:{{.openstack_version}}
        command: ["/opt/openstack/neutron/bin/neutron-db-manage", "--config-file", "/etc/neutron/neutron.conf", "--config-file", "/etc/neutron/plugins/ml2/ml2_conf.ini", "upgrade", "head"]
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      containers:
      - name: neutron-api
        image: arnaudmorin/openstack-neutron:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/neutron/bin/uwsgi", "--http", ":9696", "--module", "neutron.wsgi.api" ]
        # imagePullPolicy: Always
        ports:
        - containerPort: 9696
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      volumes:
      - name: neutron-conf
        configMap:
          name: neutron-conf
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: neutron-rpc
  labels:
    app: neutron-rpc
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: neutron-rpc
  template:
    metadata:
      labels:
        app: neutron-rpc
    spec:
      containers:
      - name: neutron-rpc
        image: arnaudmorin/openstack-neutron:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/neutron/bin/neutron-rpc-server" ]
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      volumes:
      - name: neutron-conf
        configMap:
          name: neutron-conf

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: neutron-wireguard-rpc
  labels:
    app: neutron-wireguard-rpc
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: neutron-wireguard-rpc
  template:
    metadata:
      labels:
        app: neutron-wireguard-rpc
    spec:
      containers:
      - name: neutron-wireguard-rpc
        image: arnaudmorin/openstack-neutron:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/neutron/bin/neutron-wireguard-rpc" ]
        volumeMounts:
        - name: neutron-conf
          mountPath: /etc/neutron/neutron.conf
          subPath: neutron.conf
        - name: neutron-conf
          mountPath: /etc/neutron/plugins/ml2/ml2_conf.ini
          subPath: ml2_conf.ini
      volumes:
      - name: neutron-conf
        configMap:
          name: neutron-conf
