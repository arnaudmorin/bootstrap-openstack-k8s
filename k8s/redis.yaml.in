---
apiVersion: v1
kind: ConfigMap
metadata:
  name: redis-conf
data:
  redis.conf: |
    requirepass {{.password}}

---
apiVersion: v1
kind: Service
metadata:
  name: redis
spec:
  selector:
    app: redis
  ports:
  - port: 6379
    nodePort: 30679
    name: redis
  # Redis service is type LoadBalancer in order to be reachable from outside the k8s cluster
  type: LoadBalancer

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
spec:
  selector:
    matchLabels:
      app: redis
  template:
    metadata:
      labels:
        app: redis
    spec:
      containers:
      - image: redis
        name: redis
        command: ["redis-server", "/etc/redis/redis.conf"]
        ports:
        - containerPort: 6379
          name: redis
        volumeMounts:
        - name: redis-conf
          mountPath: "/etc/redis/redis.conf"
          subPath: "redis.conf"
      volumes:
      - name: redis-conf
        configMap:
          name: redis-conf
