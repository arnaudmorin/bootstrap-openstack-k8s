---
apiVersion: v1
kind: Service
metadata:
  name: blazar
spec:
  selector:
    app: blazar
  ports:
  - port: 7557

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: blazar
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: blazar.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: blazar
            port:
              number: 7557
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blazar
  labels:
    app: blazar
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blazar
  template:
    metadata:
      labels:
        app: blazar
    spec:
      initContainers:
      containers:
      - name: blazar
        image: localhost:5000/openstack-blazar:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/blazar/bin/uwsgi", "--http", ":7557", "--wsgi-file", "/opt/openstack/blazar/bin/blazar-api-wsgi" ]
        #command: [ "/opt/openstack/blazar/bin/blazar-api" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        ports:
        - containerPort: 7557
        volumeMounts:
        - name: blazar-conf
          mountPath: /etc/blazar/blazar.conf
          subPath: blazar.conf
      volumes:
      - name: blazar-conf
        configMap:
          name: blazar-conf
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blazar-manager
  labels:
    app: blazar-manager
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blazar-manager
  template:
    metadata:
      labels:
        app: blazar-manager
    spec:
      containers:
      - name: blazar-manager
        image: localhost:5000/openstack-blazar:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/blazar/bin/blazar-manager" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        volumeMounts:
        - name: blazar-conf
          mountPath: /etc/blazar/blazar.conf
          subPath: blazar.conf
      volumes:
      - name: blazar-conf
        configMap:
          name: blazar-conf
