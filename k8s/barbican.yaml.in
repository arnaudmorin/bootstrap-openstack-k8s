---
apiVersion: v1
kind: ConfigMap
metadata:
  name: barbican-conf
data:
  uwsgi.ini: |
    [uwsgi]
    http-socket = 0.0.0.0:9311
    stats = 0.0.0.0:9191
    virtualenv = /opt/openstack/barbican/
    module = barbican.wsgi.api
    buffer-size = 65535
    lazy-apps = true
    processes = 8
    harakiri = 60
    enable-threads = true
    master = true
    thunder-lock = true
  barbican.conf: |
    [DEFAULT]
    transport_url = rabbit://openstack:{{.password}}@rabbit
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-barbican/barbican
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = glance
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    auth_type = password
    [keystone_notifications]
    enable = True
    [oslo_messaging_rabbit]
    rabbit_quorum_queue = False
    rabbit_transient_quorum_queue = True
    rabbit_qos_prefetch_count = 1
    use_queue_manager = True
    rabbit_stream_fanout = True
    amqp_durable_queues = True
    [secretstore]
    enabled_secretstore_plugins = store_crypto
    [crypto]
    enabled_crypto_plugins = simple_crypto
    [simple_crypto_plugin]
    kek = 'YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY='

---
apiVersion: v1
kind: Service
metadata:
  name: barbican
spec:
  selector:
    app: barbican
  ports:
  - port: 9311

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: barbican
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: barbican.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: barbican
            port:
              number: 9311
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: barbican
  labels:
    app: barbican
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: barbican
  template:
    metadata:
      labels:
        app: barbican
    spec:
      initContainers:
      - name: barbican-init
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        command: ["/opt/openstack/barbican/bin/barbican-manage", "db", "upgrade"]
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
      containers:
      - name: barbican
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/barbican/bin/uwsgi", "--ini", "/etc/uwsgi/barbican.ini" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        ports:
        - containerPort: 9311
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
        - name: barbican-conf
          mountPath: /etc/uwsgi/barbican.ini
          subPath: uwsgi.ini
      volumes:
      - name: barbican-conf
        configMap:
          name: barbican-conf
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: barbican-worker
  labels:
    app: barbican-worker
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: barbican-worker
  template:
    metadata:
      labels:
        app: barbican-worker
    spec:
      containers:
      - name: barbican
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/barbican/bin/barbican-worker" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
      volumes:
      - name: barbican-conf
        configMap:
          name: barbican-conf
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: barbican-keystone-listener
  labels:
    app: barbican-keystone-listener
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: barbican-keystone-listener
  template:
    metadata:
      labels:
        app: barbican-keystone-listener
    spec:
      containers:
      - name: barbican
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/barbican/bin/barbican-keystone-listener" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
      volumes:
      - name: barbican-conf
        configMap:
          name: barbican-conf
