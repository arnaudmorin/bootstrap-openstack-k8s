---
apiVersion: v1
kind: Service
metadata:
  name: barbican
spec:
  selector:
    app: barbican
  ports:
  - port: 9311

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: barbican
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: barbican.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: barbican
            port:
              number: 9311
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: barbican
  labels:
    app: barbican
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: barbican
  template:
    metadata:
      labels:
        app: barbican
    spec:
      initContainers:
      - name: barbican-init
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        command: ["/opt/openstack/barbican/bin/barbican-manage", "db", "upgrade"]
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
      containers:
      - name: barbican
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/barbican/bin/uwsgi", "--http", ":9311", "--wsgi-file", "/opt/openstack/barbican/bin/barbican-wsgi-api" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        ports:
        - containerPort: 9311
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
      volumes:
      - name: barbican-conf
        configMap:
          name: barbican-conf
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: barbican-worker
  labels:
    app: barbican-worker
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: barbican-worker
  template:
    metadata:
      labels:
        app: barbican-worker
    spec:
      containers:
      - name: barbican
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/barbican/bin/barbican-worker" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
      volumes:
      - name: barbican-conf
        configMap:
          name: barbican-conf
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: barbican-keystone-listener
  labels:
    app: barbican-keystone-listener
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: barbican-keystone-listener
  template:
    metadata:
      labels:
        app: barbican-keystone-listener
    spec:
      containers:
      - name: barbican
        image: arnaudmorin/openstack-barbican:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "/opt/openstack/barbican/bin/barbican-keystone-listener" ]
        #securityContext:
        #  allowPrivilegeEscalation: false
        #  runAsUser: 0
        # imagePullPolicy: Always
        volumeMounts:
        - name: barbican-conf
          mountPath: /etc/barbican/barbican.conf
          subPath: barbican.conf
      volumes:
      - name: barbican-conf
        configMap:
          name: barbican-conf
