---
apiVersion: v1
kind: ConfigMap
metadata:
  name: my-cnf
data:
  .my.cnf: |
    [client]
    user = root
    password = {{ .password }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keystone-conf
data:
  keystone.conf: |
    [database]
    connection = mysql+pymysql://root:{{ .password }}@mysql-keystone/keystone
    [catalog]
    template_file = /etc/keystone/default_catalog.templates
    [oslo_policy]
    policy_dirs = /etc/keystone/policy.d
    [token]
    provider = fernet
  0: |
    {{ index .keystone.fernet 0 }}
  1: |
    {{ index .keystone.fernet 1 }}

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: glance-conf
data:
  glance-api.conf: |
    [DEFAULT]
    # debug = True
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-glance/glance
    [glance_store]
    stores = file,http
    default_store = file
    filesystem_store_datadir = /var/lib/glance/images/
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = glance
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [oslo_concurrency]
    lock_path = /var/lock/glance
    [paste_deploy]
    flavor = keystone
    [taskflow_executor]
    conversion_format = raw
    [task]
    task_executor = taskflow
    work_dir = /tmp
    [image_conversion]
    output_format = raw
    [image_import_opts]
    image_import_plugins = ['image_conversion']
  glance-image-import.conf: |
    [image_conversion]
    output_format = raw
    [image_import_opts]
    image_import_plugins = ['image_conversion']

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cinder-conf
data:
  cinder.conf: |
    [DEFAULT]
    # debug = True
    auth_strategy = keystone
    transport_url = rabbit://openstack:{{.password}}@rabbit
    enabled_backends = nfs
    glance_api_servers = http://glance.{{.domain}}
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-cinder/cinder
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = cinder
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [oslo_concurrency]
    lock_path = /var/lock/cinder
    [nfs]
    volume_driver=cinder.volume.drivers.nfs.NfsDriver
    nas_host=10.201.95.118
    nas_share_path=/zpool-bhs-000917/cinder-k8s
    nfs_snapshot_support=True
    nfs_mount_options='vers=3,nolock'

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: neutron-conf
data:
  neutron.conf: |
    [DEFAULT]
    # debug = True
    auth_strategy = keystone
    core_plugin = ml2
    service_plugins = router,segments,port_forwarding,qos
    allow_overlapping_ips = true
    notify_nova_on_port_status_changes = true
    notify_nova_on_port_data_changes = true
    interface_driver = openvswitch
    router_distributed = true
    l3_ha = true
    max_l3_agents_per_router = 2
    transport_url = rabbit://openstack:{{.password}}@rabbit
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-neutron/neutron
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = neutron
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [nova]
    region_name = RegionOne
    auth_url = http://keystone.{{.domain}}/v3
    auth_type = password
    password = {{.password}}
    project_domain_name = Default
    project_name = service
    user_domain_name = Default
    username = nova
    [oslo_concurrency]
    lock_path = /var/lib/neutron/tmp
    [oslo_policy]
    policy_file = /etc/neutron/policy.json
    policy_dirs = /etc/neutron/policy.d
    [placement]
    region_name = RegionOne
    auth_url = http://keystone.{{.domain}}/v3
    auth_type = password
    password = {{.password}}
    project_domain_name = Default
    project_name = service
    user_domain_name = Default
    username = placement
  ml2_conf.ini: |
    [ml2]
    type_drivers = flat,vlan,vxlan
    tenant_network_types = vxlan
    mechanism_drivers = openvswitch,l2population
    extension_drivers = port_security,qos
    [ml2_type_flat]
    flat_networks = *
    [ml2_type_vxlan]
    vni_ranges = 1:1000
    [securitygroup]
    enable_ipset = true

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nova-conf
data:
  nova.conf: |
    [DEFAULT]
    pybasedir = /var/lib/kolla/venv/lib/python3.7/site-packages/
    bindir = /var/lib/kolla/venv/bin/
    state_path = /var/lib/nova
    transport_url = rabbit://openstack:{{.password}}@rabbit
    [api_database]
    connection = mysql+pymysql://root:{{.password}}@mysql-nova/nova_api
    os_region_name = RegionOne
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-nova/nova
    [glance]
    api_servers = http://glance.{{.domain}}
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = nova
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [neutron]
    default_floating_pool = ext-net
    service_metadata_proxy = true
    metadata_proxy_shared_secret = {{.password}}
    auth_type = password
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = neutron
    user_domain_name = Default
    password = {{.password}}
    service_name = neutron
    url = http://neutron.{{.domain}}
    region_name = RegionOne
    [oslo_concurrency]
    lock_path = /var/lib/nova/tmp
    [placement]
    auth_type = password
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = placement
    user_domain_name = Default
    password = {{.password}}
    region_name = RegionOne
    [scheduler]
    discover_hosts_in_cells_interval = 60
    [serial_console]
    enabled = true
    [spice]
    enabled = true
    server_listen = 0.0.0.0
    server_proxyclient_address = $my_ip
    # This does not work, I dont know why...
    html5proxy_base_url = http://nova.{{.domain}}:6082/spice_auto.html
    [vnc]
    enabled = true
    server_listen = 0.0.0.0
    server_proxyclient_address = $my_ip

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nova-compute-conf
data:
  nova.conf: |
    [DEFAULT]
    pybasedir = /var/lib/kolla/venv/lib/python3.7/site-packages/
    bindir = /var/lib/kolla/venv/bin/
    state_path = /var/lib/nova
    transport_url = rabbit://openstack:{{.password}}@rabbit
    compute_driver=libvirt.LibvirtDriver
    [cinder]
    os_region_name = RegionOne
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-nova/nova
    [glance]
    api_servers = http://glance.{{.domain}}
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = nova
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    auth_type = password
    [neutron]
    default_floating_pool = ext-net
    service_metadata_proxy = true
    auth_type = password
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = neutron
    user_domain_name = Default
    password = {{.password}}
    service_name = neutron
    url = http://neutron.{{.domain}}
    region_name = RegionOne
    [oslo_concurrency]
    lock_path = /var/lib/nova/tmp
    [placement]
    auth_type = password
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = placement
    user_domain_name = Default
    password = {{.password}}
    region_name = RegionOne
    [serial_console]
    enabled = true
    base_url = ws://nova.{{.domain}}:6083
    proxyclient_address = 51.195.233.251
    [spice]
    enabled = true
    server_listen = 0.0.0.0
    server_proxyclient_address = $my_ip
    [vnc]
    enabled = True
    server_listen = 0.0.0.0
    server_proxyclient_address = $my_ip
    novncproxy_base_url = http://nova.{{.domain}}:6080/vnc_auto.html

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: placement-conf
data:
  placement.conf: |
    [DEFAULT]
    pybasedir = /usr/lib/python3/dist-packages
    [api]
    auth_strategy = keystone
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = placement
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [oslo_policy]
    policy_dirs = /etc/placement/policy.d
    [placement_database]
    connection = mysql+pymysql://root:{{.password}}@mysql-placement/placement
    [placement]
    # See https://bugs.launchpad.net/placement/+bug/2070257
    max_allocation_candidates = 1000
    allocation_candidates_generation_strategy = breadth-first

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: mistral-conf
data:
  mistral.conf: |
    [DEFAULT]
    transport_url = rabbit://openstack:{{.password}}@rabbit
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = mistral
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-mistral/mistral
    #[oslo_policy]
    #policy_file = /etc/mistral/policy.yaml
  uwsgi.ini: |
    [uwsgi]
    # Listen on port 8989 and start as a full web server
    http-socket = 0.0.0.0:8989
    # Stats on port 9191
    stats = 0.0.0.0:9191
    # App to start
    virtualenv = /opt/openstack/mistral/
    #env = MISTRAL_CONFIG_DIR=/etc/mistral/
    module = mistral.wsgi:application
    # load apps in each worker instead of the master
    lazy-apps = true
    # Number of processes
    processes = 4
    # Will kill processes that run more that 60s
    harakiri = 60
    # Enable threads
    enable-threads = true
    # Gracefully manage processes
    master = true
    # Thunder-lock - serialize accept() usage (if possible)
    thunder-lock = true

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cloudflow-openrc
data:
  openrc: |
    export OS_USERNAME=admin
    export OS_PASSWORD={{.password}}
    export OS_PROJECT_NAME=admin
    export OS_USER_DOMAIN_NAME=Default
    export OS_PROJECT_DOMAIN_NAME=Default
    export OS_AUTH_URL=http://keystone.{{.domain}}/v3
    export OS_IDENTITY_API_VERSION=3

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: horizon-conf
data:
  custom_local_settings: |
    OPENSTACK_HOST = "{{.domain}}"
    OPENSTACK_KEYSTONE_URL = "http://keystone.{{.domain}}/v3"

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: skyline-conf
data:
  skyline.yaml: |
    default:
      access_token_expire: 3600
      access_token_renew: 1800
      cafile: ''
      cors_allow_origins: []
      database_url: mysql://root:{{.password}}@mysql-skyline/skyline
      debug: False
      log_dir: /var/log/skyline/
      log_file: skyline.log
      policy_file_path: /etc/skyline/policy
      policy_file_suffix: policy.yaml
      prometheus_basic_auth_password: ''
      prometheus_basic_auth_user: ''
      prometheus_enable_basic_auth: false
      prometheus_endpoint: http://localhost:9091
      secret_key: aCtmgbcUqYUy_HNVg5BDXCaeJgJQzHJXwqbXr0Nmb2o
      session_name: session
      ssl_enabled: true
    openstack:
      base_domains:
      - default
      default_region: RegionOne
      enforce_new_defaults: true
      interface_type: public
      keystone_url: http://keystone.{{.domain}}/v3
      nginx_prefix: /api/openstack
      reclaim_instance_interval: 604800
      service_mapping:
        compute: nova
        identity: keystone
        image: glance
        network: neutron
        placement: placement
      sso_enabled: false
      sso_protocols:
      - openid
      sso_region: RegionOne
      system_admin_roles:
      - admin
      - system_admin
      system_project: service
      system_project_domain: default
      system_reader_roles:
      - system_reader
      system_user_domain: default
      system_user_name: skyline
      system_user_password: {{.password}}
    setting:
      base_settings:
      - flavor_families
      - gpu_models
      - usb_models
      flavor_families:
      - architecture: x86_architecture
        categories:
        - name: general_purpose
          properties: []
        - name: compute_optimized
          properties: []
        - name: memory_optimized
          properties: []
        - name: high_clock_speed
          properties: []
      - architecture: heterogeneous_computing
        categories:
        - name: compute_optimized_type_with_gpu
          properties: []
        - name: visualization_compute_optimized_type_with_gpu
          properties: []
      gpu_models:
      - nvidia_t4
      usb_models:
      - usb_c
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: octavia-conf
data:
  octavia.conf: |
    [DEFAULT]
    transport_url = rabbit://openstack:{{.password}}@rabbit
    debug = False
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-octavia/octavia
    [api_settings]
    bind_host = 0.0.0.0
    [service_auth]
    auth_version = v3
    auth_type = v3password
    auth_url = http://keystone.{{.domain}}/v3
    project_domain_id = default
    user_domain_id = default
    project_name = service
    username = octavia
    password = {{.password}}
    connect_retries = 5
    [certificates]
    cert_generator = local_cert_generator
    ca_certificate = /etc/octavia/certificates/server_ca.cert.pem
    ca_private_key = /etc/octavia/certificates/server_ca.key.pem
    ca_private_key_passphrase = pass
    [controller_worker]
    client_ca = /etc/octavia/certificates/client_ca.cert.pem
    amp_flavor_id = {{.amp.flavor_id}}
    amp_image_tag = amphora
    amp_ssh_key_name = amphora_keypair
    amp_boot_network_list = {{.amp.boot_network_list}}
    amp_secgroup_list = {{.amp.secgroup_list}}
    loadbalancer_topology = ACTIVE_STANDBY
    [haproxy_amphora]
    client_cert = /etc/octavia/certificates/client_ca.cert-and-key.pem
    server_ca = /etc/octavia/certificates/server_ca.cert.pem
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = octavia
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    auth_type = password
  server_ca_cert: |
