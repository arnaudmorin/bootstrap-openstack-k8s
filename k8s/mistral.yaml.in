---
apiVersion: v1
kind: Service
metadata:
  name: mistral
spec:
  selector:
    app: mistral-api
  ports:
  - port: 8989

---
apiVersion: v1
kind: Service
metadata:
  name: cloudflow
spec:
  selector:
    app: cloudflow
  ports:
  - port: 80

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: mistral
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  rules:
  - host: mistral.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: mistral
            port:
              number: 8989

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: cloudflow
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  rules:
  - host: cloudflow.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: cloudflow
            port:
              number: 80

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mistral-api
  labels:
    app: mistral-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mistral-api
  template:
    metadata:
      labels:
        app: mistral-api
    spec:
      initContainers:
      - name: mistral-upgrade-head
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        command: ["/opt/openstack/mistral/bin/mistral-db-manage", "--config-file", "/etc/mistral/mistral.conf", "upgrade", "head"]
        volumeMounts:
        - name: mistral-conf
          mountPath: /etc /mistral/mistral.conf
          subPath: mistral.conf
      - name: mistral-db-populate
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        command: ["/opt/openstack/mistral/bin/mistral-db-manage", "--config-file", "/etc/mistral/mistral.conf", "populate"]
        volumeMounts:
        - name: mistral-conf
          mountPath: /etc/mistral/mistral.conf
          subPath: mistral.conf
      containers:
      - name: mistral-api
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        # Uncomment when https://review.opendev.org/c/openstack/mistral/+/959603 is ready
        #args: [ "--ini", "/etc/uwsgi/mistral.ini" ]
        #command: [ "/opt/openstack/mistral/bin/uwsgi" ]
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/mistral/bin/mistral-server", "--server", "api" ]
        #imagePullPolicy: Never
        ports:
        - containerPort: 8989
        volumeMounts:
        - name: mistral-conf
          mountPath: "/etc/mistral/mistral.conf"
          subPath: mistral.conf
        - name: mistral-conf
          mountPath: "/etc/uwsgi/mistral.ini"
          subPath: uwsgi.ini
      volumes:
      - name: mistral-conf
        configMap:
          name: mistral-conf

---

apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mistral-engine
  labels:
    app: mistral-engine
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  serviceName: mistral-engine
  replicas: 1
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: mistral-engine
  template:
    metadata:
      labels:
        app: mistral-engine
    spec:
      containers:
      - name: mistral-engine
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/mistral/bin/mistral-server", "--server", "engine" ]
        volumeMounts:
        - name: mistral-conf
          mountPath: "/etc/mistral/mistral.conf"
          subPath: mistral.conf
      volumes:
      - name: mistral-conf
        configMap:
          name: mistral-conf

---

apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mistral-executor
  labels:
    app: mistral-executor
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  serviceName: mistral-executor
  replicas: 1
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: mistral-executor
  template:
    metadata:
      labels:
        app: mistral-executor
    spec:
      containers:
      - name: mistral-executor
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/mistral/bin/mistral-server", "--server", "executor" ]
        volumeMounts:
        - name: mistral-conf
          mountPath: "/etc/mistral/mistral.conf"
          subPath: mistral.conf
      volumes:
      - name: mistral-conf
        configMap:
          name: mistral-conf

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflow
  labels:
    app: cloudflow
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cloudflow
  template:
    metadata:
      labels:
        app: cloudflow
    spec:
      containers:
      - name: cloudflow
        image: arnaudmorin/openstack-cloudflow:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 80
        env:
        - name: CF_MISTRAL_URL
          value: http://mistral.{{.domain}}
        volumeMounts:
        - name: cloudflow-openrc
          mountPath: "/etc/openrc"
          subPath: openrc
      volumes:
      - name: cloudflow-openrc
        configMap:
          name: cloudflow-openrc
