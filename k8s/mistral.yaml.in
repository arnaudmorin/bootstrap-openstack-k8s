---
apiVersion: v1
kind: ConfigMap
metadata:
  name: mistral-conf
data:
  mistral.conf: |
    [DEFAULT]
    transport_url = rabbit://openstack:{{.password}}@rabbit
    [keystone_authtoken]
    auth_url = http://keystone.{{.domain}}/v3
    project_name = service
    project_domain_name = Default
    username = mistral
    user_domain_name = Default
    password = {{.password}}
    www_authenticate_uri = http://keystone.{{.domain}}
    region_name = RegionOne
    #memcached_servers = keystone:11211
    auth_type = password
    [database]
    connection = mysql+pymysql://root:{{.password}}@mysql-mistral/mistral
    #[oslo_policy]
    #policy_file = /etc/mistral/policy.yaml
    [oslo_concurrency]
    lock_path = /var/lock/mistral
    [cache]
    backend = dogpile.cache.redis
    redis_server = redis:6379
    password = {{ .password }}
    [oslo_messaging_rabbit]
    rabbit_quorum_queue = True
    rabbit_transient_quorum_queue = True
    rabbit_qos_prefetch_count = 1
    use_queue_manager = True
    rabbit_stream_fanout = True
  uwsgi.ini: |
    [uwsgi]
    # Listen on port 8989 and start as a full web server
    http-socket = 0.0.0.0:8989
    # Stats on port 9191
    stats = 0.0.0.0:9191
    # App to start
    virtualenv = /opt/openstack/mistral/
    #env = MISTRAL_CONFIG_DIR=/etc/mistral/
    module = mistral.wsgi:application
    # load apps in each worker instead of the master
    lazy-apps = true
    # Number of processes
    processes = 4
    # Will kill processes that run more that 60s
    harakiri = 60
    # Enable threads
    enable-threads = true
    # Gracefully manage processes
    master = true
    # Thunder-lock - serialize accept() usage (if possible)
    thunder-lock = true

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cloudflow-openrc
data:
  openrc: |
    export OS_USERNAME=admin
    export OS_PASSWORD={{.password}}
    export OS_PROJECT_NAME=admin
    export OS_USER_DOMAIN_NAME=Default
    export OS_PROJECT_DOMAIN_NAME=Default
    export OS_AUTH_URL=http://keystone.{{.domain}}/v3
    export OS_IDENTITY_API_VERSION=3

---
apiVersion: v1
kind: Service
metadata:
  name: mistral
spec:
  selector:
    app: mistral-api
  ports:
  - port: 8989

---
apiVersion: v1
kind: Service
metadata:
  name: cloudflow
spec:
  selector:
    app: cloudflow
  ports:
  - port: 80

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: mistral
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: mistral.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: mistral
            port:
              number: 8989

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: cloudflow
  annotations:
    spec.ingressClassName: traefik
spec:
  rules:
  - host: cloudflow.{{.domain}}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: cloudflow
            port:
              number: 80

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mistral-api
  labels:
    app: mistral-api
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mistral-api
  template:
    metadata:
      labels:
        app: mistral-api
    spec:
      initContainers:
      - name: mistral-upgrade-head
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        command: ["/opt/openstack/mistral/bin/mistral-db-manage", "--config-file", "/etc/mistral/mistral.conf", "upgrade", "head"]
        volumeMounts:
        - name: mistral-conf
          mountPath: "/etc/mistral/mistral.conf"
          subPath: mistral.conf
      - name: mistral-db-populate
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        command: ["/opt/openstack/mistral/bin/mistral-db-manage", "--config-file", "/etc/mistral/mistral.conf", "populate"]
        volumeMounts:
        - name: mistral-conf
          mountPath: /etc/mistral/mistral.conf
          subPath: mistral.conf
      containers:
      - name: mistral-api
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        # Uncomment when https://review.opendev.org/c/openstack/mistral/+/959603 is ready
        #args: [ "--ini", "/etc/uwsgi/mistral.ini" ]
        #command: [ "/opt/openstack/mistral/bin/uwsgi" ]
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/mistral/bin/mistral-server", "--server", "api" ]
        #imagePullPolicy: Never
        ports:
        - containerPort: 8989
        volumeMounts:
        - name: mistral-conf
          mountPath: "/etc/mistral/mistral.conf"
          subPath: mistral.conf
        - name: mistral-conf
          mountPath: "/etc/uwsgi/mistral.ini"
          subPath: uwsgi.ini
      volumes:
      - name: mistral-conf
        configMap:
          name: mistral-conf

---

apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mistral-engine
  labels:
    app: mistral-engine
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  serviceName: mistral-engine
  replicas: 1
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: mistral-engine
  template:
    metadata:
      labels:
        app: mistral-engine
    spec:
      containers:
      - name: mistral-engine
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/mistral/bin/mistral-server", "--server", "engine" ]
        volumeMounts:
        - name: mistral-conf
          mountPath: "/etc/mistral/mistral.conf"
          subPath: mistral.conf
      volumes:
      - name: mistral-conf
        configMap:
          name: mistral-conf

---

apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mistral-executor
  labels:
    app: mistral-executor
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  serviceName: mistral-executor
  replicas: 1
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: mistral-executor
  template:
    metadata:
      labels:
        app: mistral-executor
    spec:
      containers:
      - name: mistral-executor
        image: arnaudmorin/openstack-mistral:{{.openstack_version}}
        command: [ "dumb-init", "--single-child", "--" ]
        args: [ "/opt/openstack/mistral/bin/mistral-server", "--server", "executor" ]
        volumeMounts:
        - name: mistral-conf
          mountPath: "/etc/mistral/mistral.conf"
          subPath: mistral.conf
      volumes:
      - name: mistral-conf
        configMap:
          name: mistral-conf

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflow
  labels:
    app: cloudflow
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cloudflow
  template:
    metadata:
      labels:
        app: cloudflow
    spec:
      containers:
      - name: cloudflow
        image: arnaudmorin/openstack-cloudflow:{{.openstack_version}}
        #command: [ "/bin/bash", "-c", "--" ]
        #args: [ "while true; do sleep 30; done;" ]
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 80
        env:
        - name: CF_MISTRAL_URL
          value: http://mistral.{{.domain}}
        volumeMounts:
        - name: cloudflow-openrc
          mountPath: "/etc/openrc"
          subPath: openrc
      volumes:
      - name: cloudflow-openrc
        configMap:
          name: cloudflow-openrc
