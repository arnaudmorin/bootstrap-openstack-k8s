#!/bin/bash
# Keycloak bootstrap script - configures realm, clients, roles, users for OpenStack
#
# Usage: ./keycloak-bootstrap [--settings keycloak-settings.yaml]
#
# Prerequisites:
#   - Keycloak running and accessible
#   - kcadm.sh in PATH
#   - KEYCLOAK_URL, KEYCLOAK_USER, KEYCLOAK_PASSWORD environment variables
#   - OpenStack openrc sourced (for project IDs)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETTINGS_FILE="${1:-${SCRIPT_DIR}/keycloak-settings.yaml}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Check prerequisites
check_prerequisites() {
    if ! command -v kcadm.sh &> /dev/null; then
        log_error "kcadm.sh not found. Install Keycloak CLI first."
        exit 1
    fi

    if [ -z "$KEYCLOAK_URL" ] || [ -z "$KEYCLOAK_USER" ] || [ -z "$KEYCLOAK_PASSWORD" ]; then
        log_error "KEYCLOAK_URL, KEYCLOAK_USER, KEYCLOAK_PASSWORD must be set"
        log_error "Source keycloakrc first: source /root/keycloakrc"
        exit 1
    fi
}

# Wait for Keycloak to be ready
wait_for_keycloak() {
    log_info "Waiting for Keycloak to be ready..."
    for i in {1..30}; do
        if kcadm.sh get realms 2>&1 | grep -q "openstack\|master"; then
            log_info "Keycloak is ready"
            return 0
        fi
        log_info "Waiting for Keycloak... ($i/30)"
        sleep 5
    done
    log_error "Keycloak not ready after 150 seconds"
    exit 1
}

# Configure kcadm.sh credentials
configure_credentials() {
    log_info "Configuring kcadm.sh credentials..."
    kcadm.sh config credentials \
        --server "${KEYCLOAK_URL}" \
        --realm master \
        --user "${KEYCLOAK_USER}" \
        --password "${KEYCLOAK_PASSWORD}" > /dev/null 2>&1 || {
        log_warn "Keycloak credentials configuration may have failed, retrying..."
        sleep 5
        kcadm.sh config credentials \
            --server "${KEYCLOAK_URL}" \
            --realm master \
            --user "${KEYCLOAK_USER}" \
            --password "${KEYCLOAK_PASSWORD}"
    }
}

# Create realm if it doesn't exist
create_realm() {
    local realm="openstack"
    if ! kcadm.sh get "realms/${realm}" 2>&1 | grep -q '"realm"'; then
        log_info "Creating realm: ${realm}"
        echo '{"realm": "openstack", "enabled": true}' | kcadm.sh create realms -f -
    else
        log_info "Realm '${realm}' already exists"
    fi
}

# Create client
create_client() {
    local client_id="$1"
    local client_json="$2"

    EXISTING_CLIENTS=$(kcadm.sh get realms/openstack/clients --fields clientId 2>&1 || echo "")
    if ! echo "$EXISTING_CLIENTS" | grep -q "\"${client_id}\""; then
        log_info "Creating client: ${client_id}"
        echo "$client_json" | kcadm.sh create realms/openstack/clients -f -
    else
        log_info "Client '${client_id}' already exists"
    fi
}

# Add protocol mappers to client
add_protocol_mappers() {
    local client_id="$1"

    # Get client UUID
    local client_uuid
    client_uuid=$(kcadm.sh get realms/openstack/clients --fields id,clientId 2>&1 | \
        python3 -c 'import sys, json; [print(c["id"]) for c in json.load(sys.stdin) if c.get("clientId") == "'"${client_id}"'"]' 2>/dev/null || echo "")

    if [ -z "$client_uuid" ]; then
        log_warn "Could not find client UUID for ${client_id}"
        return
    fi

    log_info "Adding protocol mappers to ${client_id}..."

    # Check if mappers already exist
    local existing_mappers
    existing_mappers=$(kcadm.sh get "realms/openstack/clients/${client_uuid}/protocol-mappers/models" 2>&1 | \
        python3 -c 'import sys, json; print(len(json.load(sys.stdin)))' 2>/dev/null || echo "0")

    if [ "$existing_mappers" -lt "8" ]; then
        # User attribute mappers
        for attr in project_id project_name project_domain user_domain project_domain_id user_domain_id; do
            echo "{\"name\": \"${attr}\", \"protocol\": \"openid-connect\", \"protocolMapper\": \"oidc-usermodel-attribute-mapper\", \"config\": {\"user.attribute\": \"${attr}\", \"claim.name\": \"${attr}\", \"jsonType.label\": \"String\", \"id.token.claim\": \"true\", \"access.token.claim\": \"true\", \"userinfo.token.claim\": \"true\", \"introspection.token.claim\": \"true\"}}" | \
                kcadm.sh create "realms/openstack/clients/${client_uuid}/protocol-mappers/models" -f - 2>/dev/null || true
        done

        # Realm roles mapper
        echo '{"name": "openstack_roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper", "config": {"claim.name": "realm_access.roles", "multivalued": "true", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | \
            kcadm.sh create "realms/openstack/clients/${client_uuid}/protocol-mappers/models" -f - 2>/dev/null || true

        # Openstack roles as string mapper
        echo '{"name": "openstack_roles_string", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "config": {"user.attribute": "openstack_roles", "claim.name": "openstack_roles", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}' | \
            kcadm.sh create "realms/openstack/clients/${client_uuid}/protocol-mappers/models" -f - 2>/dev/null || true

        log_info "Protocol mappers added"
    else
        log_info "Protocol mappers already exist"
    fi
}

# Update User Profile to register custom attributes (required for Keycloak 26.x)
update_user_profile() {
    log_info "Updating User Profile to register custom attributes..."

    python3 << 'PYTHON_EOF'
import subprocess
import json
import sys
import os
import requests

keycloak_url = os.environ.get('KEYCLOAK_URL', '')
admin_user = os.environ.get('KEYCLOAK_USER', 'admin')
admin_password = os.environ.get('KEYCLOAK_PASSWORD', '')

if not keycloak_url or not admin_password:
    print("[WARN] Keycloak environment variables not set", file=sys.stderr)
    sys.exit(1)

try:
    token_url = f'{keycloak_url}/realms/master/protocol/openid-connect/token'
    token_data = {
        'client_id': 'admin-cli',
        'username': admin_user,
        'password': admin_password,
        'grant_type': 'password'
    }
    token_resp = requests.post(token_url, data=token_data, timeout=10)
    token_resp.raise_for_status()
    admin_token = token_resp.json().get('access_token', '')
except Exception as e:
    print(f"[WARN] Failed to authenticate: {e}", file=sys.stderr)
    sys.exit(1)

try:
    result = subprocess.run(['kcadm.sh', 'get', 'realms/openstack/users/profile'],
                          capture_output=True, text=True, check=True)
    profile = json.loads(result.stdout)
except:
    profile = {"attributes": [], "groups": []}

custom_attrs = [
    {'name': 'project_id', 'displayName': 'OpenStack Project ID', 'permissions': {'view': ['admin'], 'edit': ['admin']}, 'multivalued': False},
    {'name': 'project_name', 'displayName': 'OpenStack Project Name', 'permissions': {'view': ['admin'], 'edit': ['admin']}, 'multivalued': False},
    {'name': 'project_domain', 'displayName': 'OpenStack Project Domain', 'permissions': {'view': ['admin'], 'edit': ['admin']}, 'multivalued': False},
    {'name': 'user_domain', 'displayName': 'OpenStack User Domain', 'permissions': {'view': ['admin'], 'edit': ['admin']}, 'multivalued': False},
    {'name': 'project_domain_id', 'displayName': 'OpenStack Project Domain Id', 'permissions': {'view': ['admin'], 'edit': ['admin']}, 'multivalued': False},
    {'name': 'user_domain_id', 'displayName': 'OpenStack User Domain Id', 'permissions': {'view': ['admin'], 'edit': ['admin']}, 'multivalued': False},
    {'name': 'openstack_roles', 'displayName': 'OpenStack Roles', 'permissions': {'view': ['admin'], 'edit': ['admin']}, 'multivalued': False}
]

existing_names = {a.get('name') for a in profile.get('attributes', [])}
added = False
for attr in custom_attrs:
    if attr['name'] not in existing_names:
        profile.setdefault('attributes', []).append(attr)
        added = True

if added:
    profile_url = f'{keycloak_url}/admin/realms/openstack/users/profile'
    headers = {'Authorization': f'Bearer {admin_token}', 'Content-Type': 'application/json'}
    try:
        update_resp = requests.put(profile_url, json=profile, headers=headers, timeout=10)
        update_resp.raise_for_status()
        print("[INFO] User Profile updated successfully")
    except requests.exceptions.RequestException as e:
        print(f"[WARN] User Profile update failed: {e}", file=sys.stderr)
else:
    print("[INFO] User Profile already has custom attributes")
PYTHON_EOF
}

# Create role if it doesn't exist
create_role() {
    local role_name="$1"
    local role_desc="$2"

    if ! kcadm.sh get realms/openstack/roles 2>&1 | grep -q "\"name\" : \"${role_name}\""; then
        log_info "Creating role: ${role_name}"
        echo "{\"name\": \"${role_name}\", \"description\": \"${role_desc}\"}" | kcadm.sh create realms/openstack/roles -f -
    else
        log_info "Role '${role_name}' already exists"
    fi
}

# Create user with attributes
create_user() {
    local username="$1"
    local email="$2"
    local first_name="$3"
    local last_name="$4"
    local password="$5"
    local project_id="$6"
    local project_name="$7"
    local domain_id="$8"
    local roles="$9"

    # Delete existing user if it exists
    local existing_user
    existing_user=$(kcadm.sh get realms/openstack/users --query "username=${username}" 2>&1 | \
        python3 -c 'import sys, json; users = json.load(sys.stdin); [print(u["id"]) for u in users if u.get("username") == "'"${username}"'"]' 2>/dev/null || echo "")

    if [ -n "$existing_user" ]; then
        log_info "Deleting existing user: ${username}"
        kcadm.sh delete "realms/openstack/users/${existing_user}" 2>/dev/null || true
    fi

    log_info "Creating user: ${username}"
    cat <<EOF | kcadm.sh create realms/openstack/users -f -
{
  "username": "${username}",
  "enabled": true,
  "emailVerified": true,
  "requiredActions": [],
  "email": "${email}",
  "firstName": "${first_name}",
  "lastName": "${last_name}",
  "attributes": {
    "project_id": ["${project_id}"],
    "project_name": ["${project_name}"],
    "project_domain": ["Default"],
    "user_domain": ["Default"],
    "project_domain_id": ["${domain_id}"],
    "user_domain_id": ["${domain_id}"],
    "openstack_roles": ["${roles}"]
  },
  "credentials": [{
    "type": "password",
    "value": "${password}",
    "temporary": false
  }]
}
EOF
}

# Assign role to user
assign_role() {
    local username="$1"
    local rolename="$2"
    kcadm.sh add-roles --realm openstack --uusername "$username" --rolename "$rolename" 2>/dev/null || true
}

# Get nova-middleware client secret and update config.yaml
update_client_secret() {
    log_info "Retrieving client secret for nova-middleware..."

    local client_uuid
    client_uuid=$(kcadm.sh get realms/openstack/clients --fields id,clientId 2>&1 | \
        python3 -c 'import sys, json; [print(c["id"]) for c in json.load(sys.stdin) if c.get("clientId") == "nova-middleware"]' 2>/dev/null || echo "")

    if [ -n "$client_uuid" ]; then
        local client_secret
        client_secret=$(kcadm.sh get "realms/openstack/clients/${client_uuid}/client-secret" 2>&1 | \
            python3 -c 'import sys, json; print(json.load(sys.stdin).get("value", ""))' 2>/dev/null || echo "")

        # If secret is empty, generate a new one
        if [ -z "$client_secret" ] || [ "$client_secret" = "null" ]; then
            log_info "Client secret is empty, generating new one..."
            kcadm.sh create "realms/openstack/clients/${client_uuid}/client-secret" 2>/dev/null || true
            client_secret=$(kcadm.sh get "realms/openstack/clients/${client_uuid}/client-secret" 2>&1 | \
                python3 -c 'import sys, json; print(json.load(sys.stdin).get("value", ""))' 2>/dev/null || echo "")
        fi

        if [ -n "$client_secret" ] && [ "$client_secret" != "null" ]; then
            log_info "Client secret: ${client_secret}"

            # Update config.yaml if it exists (use path relative to script location)
            local config_file="${SCRIPT_DIR}/../config/config.yaml"
            if [ -f "$config_file" ]; then
                if grep -q "keycloak_client_secret:" "$config_file"; then
                    sed -i "s/keycloak_client_secret:.*/keycloak_client_secret: ${client_secret}/" "$config_file"
                else
                    echo "keycloak_client_secret: ${client_secret}" >> "$config_file"
                fi
                log_info "Updated keycloak_client_secret in $config_file"
            else
                log_warn "Config file not found: $config_file"
            fi
        else
            log_warn "Could not retrieve client secret"
        fi
    else
        log_warn "Could not find nova-middleware client UUID"
    fi
}

# Main
main() {
    check_prerequisites
    configure_credentials
    wait_for_keycloak

    # Create realm
    create_realm

    # Create clients
    log_info "Configuring Keycloak clients..."

    # nova-middleware client (for token introspection)
    # Note: Don't include "secret" field - Keycloak will auto-generate one
    create_client "nova-middleware" '{
        "clientId": "nova-middleware",
        "enabled": true,
        "clientAuthenticatorType": "client-secret",
        "serviceAccountsEnabled": true,
        "standardFlowEnabled": false,
        "directAccessGrantsEnabled": false,
        "publicClient": false,
        "protocol": "openid-connect"
    }'

    # openstack-client (for user authentication)
    create_client "openstack-client" '{
        "clientId": "openstack-client",
        "enabled": true,
        "publicClient": true,
        "standardFlowEnabled": true,
        "directAccessGrantsEnabled": true,
        "serviceAccountsEnabled": false,
        "redirectUris": ["*"],
        "webOrigins": ["*"],
        "protocol": "openid-connect"
    }'

    # Add protocol mappers
    add_protocol_mappers "openstack-client"

    # Update User Profile (Keycloak 26.x)
    update_user_profile

    # Create roles
    create_role "nova:reboot" "Permission to reboot Nova instances"
    create_role "default" "Default role"
    create_role "member" "Member role"

    # Get OpenStack project info
    local project_id=""
    local project_name="demo"
    local domain_id="default"

    if command -v openstack &> /dev/null; then
        project_id=$(openstack project show demo -c id -f value 2>/dev/null || echo "")
        domain_id=$(openstack domain show default -c id -f value 2>/dev/null || echo "default")
    fi

    if [ -z "$project_id" ]; then
        log_warn "Could not get demo project ID from OpenStack"
        log_warn "You may need to configure Keycloak users manually"
    else
        # Get demo password from openrc_demo
        local demo_password
        demo_password=$(grep "^export OS_PASSWORD=" /root/openrc_demo 2>/dev/null | cut -d'=' -f2 | tr -d '"' || echo "changeme")

        # Create users
        create_user "nova-restart-user" "nova-restart@example.com" "Nova" "Restart" "changeme" "$project_id" "$project_name" "$domain_id" "nova:reboot"
        assign_role "nova-restart-user" "nova:reboot"

        create_user "demo" "demo@example.com" "Demo" "User" "$demo_password" "$project_id" "$project_name" "$domain_id" "default,member"

        create_user "demo-reboot-only" "demo-reboot@example.com" "Demo" "RebootOnly" "$demo_password" "$project_id" "$project_name" "$domain_id" "nova:reboot"
        assign_role "demo-reboot-only" "nova:reboot"

        create_user "demo-keycloak" "demo-kc@example.com" "Demo" "Keycloak" "$demo_password" "$project_id" "$project_name" "$domain_id" "default,member"
        assign_role "demo-keycloak" "default"
        assign_role "demo-keycloak" "member"

        log_info "Users created with project ${project_name} (${project_id})"
    fi

    # Update client secret
    update_client_secret

    log_info "Keycloak configuration completed!"
}

main "$@"
