---
# Global password used everywhere
# NOTE(arnaud) this is not very secure but we dont want to prove security for now
password: changeme

# Domain used for your OpenStack deployment
# Make sure to point this domain and all subdomains to
# a worker IP
# keystone.{{domain}}
# glance.{{domain}}
# nova.{{domain}}
# placement.{{domain}}
# neutron.{{domain}}
#
# Or use something like this:
# your-ip.xip.opensteak.fr
#
# And replace your-ip with the result of this command:
# hostname -I | awk '{print $1}'
domain: somewhere.net

# OpenStack release you want to use
# This could be something like: 2025.1
openstack_version: "os_version"

# Debian packages for nova and neutron on the compute and network nodes, from
# https://github.com/arnaudmorin/openstack-debian/releases
# "latest" picks the newest release of openstack_version,
# or pin one, e.g.: "2026.2-38+0e20d52"
deb_release: latest

# Messaging backend: rabbit (RabbitMQ) or bmq (BlazingMQ)
# NOTE(arnaud) bmq relies on the BlazingMQ driver of
# https://github.com/arnaudmorin/oslo.messaging, installed in all images and debs
messaging: rabbit

# transport_url for each messaging backend, used from inside k8s and from the
# compute/network nodes (through the k8s NodePort)
transport_url:
  rabbit: "rabbit://openstack:changeme@rabbit"
  bmq: "bmq://blazingmq:30114/bmq.openstack.priority"
transport_url_external:
  rabbit: "rabbit://openstack:changeme@somewhere.net:30672"
  bmq: "bmq://somewhere.net:30674/bmq.openstack.priority"

# Keystone fernet
# These are the keys keystone will use to generate tokens
# You can keep the following values, or regenerate new ones with:
# kubectl run -it --rm keystone-fernet-gen --image=ghcr.io/arnaudmorin/openstack-keystone:2026.2 --restart=Never -- bash -c 'keystone-manage fernet_setup --keystone-user keystone --keystone-group keystone ; echo "fernet:" ; echo "  - \"$(cat /etc/keystone/fernet-keys/0)\"" ; echo "  - \"$(cat /etc/keystone/fernet-keys/1)\""'
keystone:
  fernet:
    - "IytEr50hW0rsmA9dfhPc6vBJe1KN8MoPFJxy2ARv_S0="
    - "kcDENFZQ6cLCvMliOgZjZB4y1Tf0AyX6Oed7HP0ylf8="

# Octavia AMP
amp:
  flavor_id: "amp_flavor_id"
  boot_network_list: "amp_boot_network_list"
  secgroup_list: "amp_secgroup_list"

# garage-webui admin login as "username:bcrypt_hash" (generated at bootstrap)
garage_webui_auth: "webui_auth_hash"

# Garage S3 credentials for the glance image backend (generated at bootstrap)
garage_glance_key: "glance_s3_key"
garage_glance_secret: "glance_s3_secret"
